---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  schema?: object;
}

const SITE_URL = 'https://casarocacanggu.com';

const {
  title = 'Casa Roca Canggu - Boutique Guest House in Batu Bolong, Bali',
  description = 'Casa Roca is a 10-room boutique guest house on Jl. Batu Bolong, Canggu, Bali. Private balcony, en-suite bathroom, AC, TV & free parking. 2 minutes walk to Batu Bolong Beach. Book direct for best rates.',
  canonical = `${SITE_URL}/`,
  image = `${SITE_URL}/images/hero.jpg`,
  schema,
} = Astro.props;

// Absolute-ify page-supplied image paths (e.g. blog post frontmatter uses site-relative paths).
const ogImage = image.startsWith('http') ? image : `${SITE_URL}${image}`;

const schemaLodging = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'Casa Roca Canggu',
  description: 'Casa Roca is a 10-room boutique guest house on Jl. Batu Bolong, Canggu, Bali.',
  url: SITE_URL,
  email: 'info@casarocacanggu.com',
  image: `${SITE_URL}/images/hero.jpg`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jl. Batu Bolong',
    addressLocality: 'Canggu',
    addressRegion: 'Kuta Utara, Badung, Bali',
    postalCode: '80361',
    addressCountry: 'ID',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -8.657868626182607,
    longitude: 115.13107593356986,
  },
  numberOfRooms: 10,
  checkinTime: '14:00',
  checkoutTime: '12:00',
  priceRange: '$$',
};

// Site-wide entity graph — helps Google's Knowledge Panel and gives AI/GEO
// engines a clean Organization/WebSite record to cite Casa Roca by name.
const schemaOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Casa Roca Canggu',
  url: SITE_URL,
  logo: `${SITE_URL}/images/logo.png`,
  email: 'info@casarocacanggu.com',
};

const schemaWebsite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Casa Roca Canggu',
  url: SITE_URL,
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Casa Roca Canggu" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />

    <!-- Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrganization)} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaWebsite)} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaLodging)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KZLNMEWL6D"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KZLNMEWL6D');
    </script>
  </head>

  <body class="bg-[#fcf9f4] font-[Inter] text-[14px] text-[#1c1c19] antialiased selection:bg-[#ffdbd0] selection:text-[#2b1610]">
    <slot />
  </body>
</html>