---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import EditorialStory from '../components/EditorialStory.astro';
import CorePillars from '../components/CorePillars.astro';
import RoomsShowcase from '../components/RoomsShowcase.astro';
import FAQSection from '../components/FAQSection.astro';
import CTABanner from '../components/CTABanner.astro';
import Footer from '../components/Footer.astro';

const faqItems = [
  {
    question: 'Where exactly is Casa Roca located?',
    answer:
      'Casa Roca is on Jl. Batu Bolong, Canggu, Kuta Utara, Badung, Bali directly next to Aston Canggu Hotel. Batu Bolong Beach is approximately 200 meters away, a 2-minute flat walk.',
  },
  {
    question: 'How far is the beach?',
    answer:
      'Batu Bolong Beach is 200 meters from Casa Roca. A flat, easy 2-minute walk past popular cafés, the surf school, and Old Man\'s beach bar.',
  },
  {
    question: 'Is breakfast included?',
    answer:
      'Casa Roca is a room-only property. Breakfast is not included, but Canggu\'s wide range of cafés and warungs, including Crate Café, Shady Shack, and Motion Café are within a short walk.',
  },
  {
    question: 'Does Casa Roca have free parking?',
    answer:
      'Yes. Casa Roca provides free secure basement parking for all guests, accommodating both motorbikes and cars, a rare convenience in central Canggu.',
  },
  {
    question: 'Does Casa Roca have a swimming pool?',
    answer:
      'Casa Roca does not have a shared pool. The property is designed as private room accommodation. Batu Bolong Beach is a 2-minute walk, and Canggu Club (with a pool) is a short ride away.',
  },
  {
    question: 'What are the check-in and check-out times?',
    answer:
      'Check-in is from 14:00 WITA. Check-out is by 12:00 WITA. Early check-in and late check-out can be requested subject to availability. Reception is open daily 08:00–20:00 WITA.',
  },
];
---

<BaseLayout
  title="Casa Roca Canggu — Boutique Guest House in Batu Bolong, Canggu, Bali"
  description="Casa Roca is a 10-room boutique guest house on Jl. Batu Bolong, Canggu. Private balcony, en-suite bathroom, AC, TV & free parking. 2 minutes walk to Batu Bolong Beach. Book direct for best rates."
  canonical="https://casarocacanggu.com/"
>
  <Header />
  <main class="w-full bg-[#fcf9f4] min-h-screen">
    <HeroSection />
    <EditorialStory />
    <CorePillars />
    <RoomsShowcase />
    <FAQSection items={faqItems} />
    <CTABanner />
  </main>
  <Footer />
</BaseLayout>
