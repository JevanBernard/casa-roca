---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABanner from '../components/CTABanner.astro';

const stats = [
  { icon: 'bedroom_parent', value: '10',   label: 'Bespoke Private Suites' },
  { icon: 'surfing',        value: '200m', label: 'Flat Walk to Batu Bolong Surf' },
  { icon: 'shield',         value: '100%', label: 'Dedicated Private Space' },
  { icon: 'concierge',      value: '08–20h', label: 'On-Site Concierge & Host' },
];

const standards = [
  {
    icon: 'lock',
    title: 'Absolute Privacy',
    desc: 'Every room has its own en-suite bathroom and private outdoor balcony. Your retreat remains undisturbed from arrival to departure.',
    footnote: 'Zero Shared Lounges',
  },
  {
    icon: 'local_parking',
    title: 'Rare Central Parking',
    desc: 'Complimentary secure underground basement parking for cars and motorbikes — an absolute rarity on bustling Jl. Batu Bolong.',
    footnote: 'Free for all guests',
  },
  {
    icon: 'beach_access',
    title: 'Effortless Beach Access',
    desc: "Just 2 minutes stroll down the avenue to Batu Bolong surf breaks, Old Man's, and Canggu's most celebrated beach cafés.",
    footnote: '200m Flat Stroll',
  },
  {
    icon: 'support_agent',
    title: 'Attentive Villa Team',
    desc: 'On-site reception open 08:00 to 20:00 WITA, offering discreet support, local insider advice, and instant WhatsApp concierge.',
    footnote: 'Daily on-property',
  },
];

const amenities = [
  { icon: 'bathtub',       title: 'Private Bathroom',       desc: 'En-suite bathroom in every room for exclusive privacy without sharing.' },
  { icon: 'shower',        title: 'Walk-in Rain Shower',    desc: 'High-pressure shower with hot water, toiletries, and rainfall head.' },
  { icon: 'water_heater',  title: 'Hot Water Heater',       desc: 'Instant continuous hot water available 24 hours a day.' },
  { icon: 'wifi',          title: 'High-Speed Free Wi-Fi',  desc: 'Super-fast fiber internet connection for remote work & streaming.' },
  { icon: 'balcony',       title: 'Private Balcony',        desc: 'Personal outdoor balcony with tropical garden view for quiet mornings.' },
  { icon: 'garage_home',   title: 'Free Basement Parking',  desc: 'Sheltered underground parking free of charge for motorbikes & cars.' },
  { icon: 'support_agent', title: 'Dedicated Receptionist', desc: 'Reception 08:00–20:00 WITA & fast-response WhatsApp concierge.' },
  { icon: 'smoke_free',    title: '100% Non-Smoking',       desc: 'Clean, smoke-free room zones for maximum rest quality.' },
  { icon: 'mode_fan',      title: 'Individual Air Con',     desc: 'Quiet, cool personal AC with independent remote control in every suite.' },
  { icon: 'tv',            title: 'Smart TV Flat Screen',   desc: 'Stream your favorite entertainment right from your comfortable bed.' },
];

const faqs = [
  {
    q: 'Is there a communal kitchen or shared swimming pool?',
    a: 'Casa Roca is intentionally designed as a room-only retreat for pure privacy. There is no shared kitchen or swimming pool on property, meaning zero communal noise or party vibes outside your door. Batu Bolong beach is an effortless 200-meter walk, and luxury beach clubs as well as Canggu Club are only minutes away.',
    open: true,
  },
  {
    q: 'What are the reception and check-in hours?',
    a: 'Our on-site reception desk welcomes guests daily from 08:00 to 20:00 WITA. Check-in is available from 14:00 WITA, and check-out is by 12:00 WITA. For guests arriving on late international flights after 20:00, we provide smooth digital self-check-in instructions and dedicated night-security coordination.',
    open: false,
  },
  {
    q: 'Is basement parking really free for cars and motorbikes?',
    a: 'Yes! We offer complimentary private basement parking accessible directly from our entry ramp. It safely shelters both rental motorbikes and full-size cars from rain and sun — an indispensable perk on high-density Batu Bolong where street parking is strictly regulated.',
    open: false,
  },
  {
    q: 'What is the Direct Booking Privilege?',
    a: 'Booking directly with Casa Roca guarantees you the absolute best rate with zero OTA commissions. Direct guests also enjoy priority early room allocation when available, direct WhatsApp host contact, and flexibility with adjustments.',
    open: false,
  },
];
---

<BaseLayout
  title="About Casa Roca Canggu — Our Story, Philosophy & Team"
  description="Casa Roca is a 10-room boutique guest house on Jl. Batu Bolong, Canggu, Bali. Learn about our philosophy, amenities, and the Villa Villa Bali team behind the property."
  canonical="https://casarocacanggu.com/about"
>
  <Header />

  <main class="w-full pt-20 bg-[#fcf9f4]">

    <!-- Ambient glow -->
    <div class="relative overflow-hidden">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[720px] h-[340px] bg-[#ffdbd0]/30 rounded-full blur-3xl pointer-events-none -z-10"></div>

      <!-- HERO -->
      <section class="max-w-[1360px] mx-auto px-5 lg:px-12 pt-10 pb-16">
        <div class="flex flex-col max-w-3xl">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-2 h-2 rounded-full bg-[#6E5249]"></span>
            <span class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#6E5249]">
              Our Story & Philosophy — Jl. Batu Bolong, Canggu
            </span>
          </div>
          <h1 class="font-['Playfair_Display'] text-[40px] lg:text-[56px] font-[400] leading-[48px] lg:leading-[64px] tracking-[-0.02em] text-[#1E1B18]">
            A Quiet Sanctuary for the Mindful Traveler
          </h1>
          <p class="mt-6 text-[16px] font-[400] leading-[26px] text-[#504441]">
            Conceived as an antidote to crowded resorts and social hostels, Casa Roca offers 10 impeccably appointed private rooms in the very heart of Canggu — just 200 meters from the ocean.
          </p>
        </div>

        <!-- Hero image -->
        <div class="mt-10 relative rounded-xl overflow-hidden shadow-xl">
          <div class="aspect-[16/9] lg:aspect-[21/9] w-full relative">
            <img
              src="/images/about-hero.jpg"
              alt="The sunlit open-air reception and lounge at Casa Roca Canggu"
              class="w-full h-full object-cover"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#1E1B18]/70 via-[#1E1B18]/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
              <div class="max-w-xl">
                <span class="inline-block px-2 py-0.5 rounded-full bg-white/90 text-[#1E1B18] text-[11px] font-[600] uppercase tracking-widest mb-2 backdrop-blur-md">
                  Architectural Feature
                </span>
                <p class="font-['Playfair_Display'] text-[22px] font-[500] leading-[30px] text-white font-normal">
                  "Where warm Balinese hospitality meets unhurried tranquility."
                </p>
                <p class="text-[14px] font-[400] leading-[22px] text-white/80 mt-1">
                  The sunlit open-air reception & lounge, crafted with limestone arches and natural teak.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- ORIGIN STORY -->
    <section class="w-full bg-[#f6f3ee] py-16 lg:py-24">
      <div class="max-w-[1360px] mx-auto px-5 lg:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">

          <!-- Left sticky column -->
          <div class="lg:col-span-5 flex flex-col gap-4">
            <span class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63]">The Genesis</span>
            <h2 class="font-['Playfair_Display'] text-[40px] font-[400] leading-[48px] tracking-[-0.01em] text-[#1E1B18]">
              Why We Built Casa Roca
            </h2>
            <p class="text-[16px] font-[400] leading-[26px] text-[#504441]">
              Every design choice began with answering a simple friction point felt by travelers around the globe who visit Bali.
            </p>
            <div class="mt-4 p-4 rounded-xl bg-white shadow-sm flex items-center gap-4">
              <div class="w-12 h-12 rounded-md bg-[#EFF2EC] text-[#5A6351] flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[24px]">explore</span>
              </div>
              <div class="flex flex-col">
                <span class="text-[18px] font-[600] leading-[26px] text-[#1E1B18]">Prime Batu Bolong Location</span>
                <span class="text-[12px] font-[500] text-[#504441]">200 meters flat stroll to the surf</span>
              </div>
            </div>
          </div>

          <!-- Right story cards -->
          <div class="lg:col-span-7 flex flex-col gap-4">
            <div class="p-6 lg:p-8 rounded-xl bg-white shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center gap-2 text-[#6E5249] mb-3">
                <span class="material-symbols-outlined text-[20px]">door_back</span>
                <h3 class="font-['Playfair_Display'] text-[22px] font-[500] leading-[30px] text-[#1E1B18]">
                  Done with Hostels, Unwilling to Pay for a Full Villa
                </h3>
              </div>
              <p class="text-[14px] font-[400] leading-[22px] text-[#504441]">
                Bali travelers often find themselves caught between two extremes: chaotic youth hostels with zero privacy, or sprawling multi-bedroom villas that are expensive, isolated, and inconvenient for solo guests or traveling couples. Casa Roca was born from a simple realization: you should not have to compromise on privacy, quality, or beach proximity.
              </p>
            </div>

            <div class="p-6 lg:p-8 rounded-xl bg-white shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-center gap-2 text-[#6E5249] mb-3">
                <span class="material-symbols-outlined text-[20px]">lock</span>
                <h3 class="font-['Playfair_Display'] text-[22px] font-[500] leading-[30px] text-[#1E1B18]">
                  10 Private Rooms. 100% Personal Space.
                </h3>
              </div>
              <p class="text-[14px] font-[400] leading-[22px] text-[#504441]">
                We created 10 self-contained private rooms, each with an en-suite rain shower bathroom, private sunlit balcony, whisper-quiet AC, and dedicated basement parking. No shared kitchen, no shared living room drama, and no forced socializing. When you close your door, the sanctuary is entirely yours.
              </p>
            </div>
          </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-16">
          {stats.map(({ icon, value, label }) => (
            <div class="p-6 rounded-xl bg-white shadow-sm flex flex-col justify-between group hover:-translate-y-1 transition-transform duration-200">
              <span class="material-symbols-outlined text-[#6E5249] text-[28px] mb-4">{icon}</span>
              <div>
                <span class="font-['Playfair_Display'] text-[40px] font-[400] leading-[48px] text-[#1E1B18] block tracking-tight">{value}</span>
                <span class="text-[13px] font-[500] text-[#504441]">{label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WHAT DEFINES US -->
    <section class="w-full bg-[#F3EFE8] py-16 lg:py-24">
      <div class="max-w-[1360px] mx-auto px-5 lg:px-12">
        <div class="max-w-2xl mb-12">
          <span class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#6E5249] block mb-2">Our Guiding Standard</span>
          <h2 class="font-['Playfair_Display'] text-[40px] font-[400] leading-[48px] tracking-[-0.01em] text-[#1E1B18]">
            What Defines a Stay at Casa Roca
          </h2>
          <p class="text-[16px] font-[400] leading-[26px] text-[#504441] mt-3">
            Uncompromising essentials crafted for independent voyagers, remote workers, and coastal explorers.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {standards.map(({ icon, title, desc, footnote }) => (
            <div class="p-6 rounded-xl bg-white shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
              <div>
                <div class="w-10 h-10 rounded-md bg-[#ebe8e3] flex items-center justify-center text-[#6E5249] mb-5">
                  <span class="material-symbols-outlined text-[22px]">{icon}</span>
                </div>
                <h3 class="text-[18px] font-[600] leading-[26px] text-[#1E1B18] mb-2">{title}</h3>
                <p class="text-[14px] font-[400] leading-[22px] text-[#504441]">{desc}</p>
              </div>
              <div class="mt-5 pt-3 border-t border-[#EAE5DC]">
                <span class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#5A6351]">{footnote}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- AMENITIES GRID -->
    <section class="w-full bg-[#f6f3ee] py-16 lg:py-24">
      <div class="max-w-[1360px] mx-auto px-5 lg:px-12">
        <div class="max-w-3xl mx-auto text-center mb-12">
          <div class="inline-flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-[#6E5249]"></span>
            <span class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#6E5249]">All-Inclusive Features</span>
          </div>
          <h2 class="font-['Playfair_Display'] text-[40px] font-[400] leading-[48px] tracking-[-0.01em] text-[#1E1B18] mt-2">
            Curated Room Amenities
          </h2>
          <p class="text-[16px] font-[400] leading-[26px] text-[#504441] mt-3">
            Every corner of each room is designed for total comfort, uninterrupted privacy, and modern traveler convenience.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
          {amenities.map(({ icon, title, desc }) => (
            <div class="p-6 rounded-xl bg-white shadow-sm flex flex-col gap-3 hover:shadow-md transition-shadow group">
              <div class="w-10 h-10 rounded-md bg-[#F3EFE8] flex items-center justify-center text-[#6E5249] group-hover:bg-[#6E5249] group-hover:text-white transition-colors">
                <span class="material-symbols-outlined text-[22px]">{icon}</span>
              </div>
              <h3 class="text-[18px] font-[600] leading-[26px] text-[#1E1B18]">{title}</h3>
              <p class="text-[14px] font-[400] leading-[22px] text-[#504441]">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- MANAGED BY VILLA VILLA BALI -->
    <section class="max-w-[1360px] mx-auto px-5 lg:px-12 py-16 lg:py-24">
      <div class="rounded-xl bg-[#f0ede9] p-8 lg:p-12 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">

          <div class="lg:col-span-7 flex flex-col gap-4">
            <span class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#6E5249]">Hospitality & Care</span>
            <h2 class="font-['Playfair_Display'] text-[40px] font-[400] leading-[48px] tracking-[-0.01em] text-[#1E1B18]">
              Managed with Heart by Villa Villa Bali
            </h2>
            <p class="text-[16px] font-[400] leading-[26px] text-[#504441]">
              Casa Roca is professionally curated and maintained by Villa Villa Bali, bringing decades of intimate Balinese hospitality to modern boutique living. Our team is committed to pristine daily room refreshes, discreet guest support, and honest recommendations for local eateries, hidden beaches, and quiet co-working corners.
            </p>
            <div class="flex flex-wrap items-center gap-6 text-[13px] font-[500] text-[#504441]">
              <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-[#5A6351] text-[18px]">clean_hands</span>
                Daily Meticulous Housekeeping
              </span>
              <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-[#5A6351] text-[18px]">wifi</span>
                High-Speed Fiber Throughout
              </span>
              <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-[#5A6351] text-[18px]">lock_clock</span>
                Secure Self-Check-in Available
              </span>
            </div>
          </div>

          <div class="lg:col-span-5 flex flex-col gap-4 p-6 rounded-xl bg-white shadow-sm">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-[#F3EFE8] flex items-center justify-center text-[#6E5249] font-['Playfair_Display'] text-[18px] font-[500]">
                CR
              </div>
              <div>
                <h4 class="text-[18px] font-[600] leading-[26px] text-[#1E1B18]">The Villa Caretakers</h4>
                <p class="text-[12px] font-[500] text-[#8A6D63]">On-site daily 08:00 – 20:00 WITA</p>
              </div>
            </div>
            <p class="text-[14px] font-[400] leading-[22px] text-[#504441] italic">
              "We want Casa Roca to be the quiet refuge you look forward to returning to after an active surf session or exploring the cafés of Canggu."
            </p>
            <a
              href="https://wa.me/62XXXXXXXXX"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-[13px] font-[500] text-[#6E5249] hover:text-[#553b33] transition-colors group"
            >
              <span>Ask our host a question on WhatsApp</span>
              <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- ESSENTIAL FACTS FAQ -->
    <section class="max-w-[1360px] mx-auto px-5 lg:px-12 pb-16 lg:pb-24">
      <div class="max-w-3xl mx-auto flex flex-col items-center text-center mb-12">
        <span class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#6E5249]">Transparency</span>
        <h2 class="font-['Playfair_Display'] text-[40px] font-[400] leading-[48px] tracking-[-0.01em] text-[#1E1B18] mt-2">
          Essential Practical Facts
        </h2>
        <p class="text-[16px] font-[400] leading-[26px] text-[#504441] mt-3">
          Clear answers about our setup so you can plan your stay with complete peace of mind.
        </p>
      </div>

      <div class="max-w-3xl mx-auto flex flex-col gap-3" id="about-faq">
        {faqs.map(({ q, a, open }) => (
          <div class:list={['rounded-xl overflow-hidden transition-all duration-200', open ? 'bg-[#f0ede9]' : 'bg-[#f6f3ee]']}>
            <button class="w-full text-left p-6 flex items-center justify-between gap-4 focus:outline-none">
              <span class="text-[18px] font-[600] leading-[26px] text-[#1E1B18]">{q}</span>
              <span class:list={['material-symbols-outlined text-[#6E5249] text-[22px] transition-transform duration-300 shrink-0', open && 'rotate-180']}>
                expand_more
              </span>
            </button>
            <div class:list={['px-6 pb-6 text-[14px] font-[400] leading-[22px] text-[#504441]', !open && 'hidden']}>
              {a}
            </div>
          </div>
        ))}
      </div>
    </section>

    <CTABanner
      title="Experience the Casa Roca Difference"
      body="10 intimate rooms in Canggu's most coveted coastal pocket. Book direct for guaranteed lowest rates, flexible arrival assistance, and dedicated parking."
      ctaLabel="Check Availability & Rates"
      ctaHref="/availability"
    />

  </main>

  <Footer />

</BaseLayout>

<script>
  document.querySelectorAll('#about-faq .rounded-xl').forEach((item) => {
    item.querySelector('button')?.addEventListener('click', () => {
      const content = item.querySelector('div:last-child');
      const icon    = item.querySelector('.material-symbols-outlined');
      const isOpen  = !content?.classList.contains('hidden');

      // Close all
      document.querySelectorAll('#about-faq .rounded-xl').forEach((el) => {
        el.querySelector('div:last-child')?.classList.add('hidden');
        const ic = el.querySelector('.material-symbols-outlined');
        if (ic) (ic as HTMLElement).style.transform = 'rotate(0deg)';
        el.classList.remove('bg-[#f0ede9]');
        el.classList.add('bg-[#f6f3ee]');
      });

      // Toggle clicked
      if (!isOpen && content && icon) {
        content.classList.remove('hidden');
        (icon as HTMLElement).style.transform = 'rotate(180deg)';
        item.classList.add('bg-[#f0ede9]');
        item.classList.remove('bg-[#f6f3ee]');
      }
    });
  });
</script>