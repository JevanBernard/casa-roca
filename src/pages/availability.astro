---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const whyDirectPoints = [
  {
    icon: 'verified',
    title: 'Best Rate Guarantee',
    body: 'We promise the lowest price when you book through our website. No hidden commissions or OTA markups.',
  },
  {
    icon: 'event_available',
    title: 'Free Cancellation',
    body: 'Free cancellation up to 48 hours before check-in when you book direct with us.',
  },
  {
    icon: 'schedule',
    title: 'Priority Early Check-in',
    body: 'Direct guests get first priority for room availability upon arrival, subject to occupancy.',
  },
];

// Kept in sync with the room data on /rooms — see src/pages/rooms.astro.
const rooms = [
  {
    name: 'Superior Double Room',
    image: '/images/superior-double-room.jpg',
    imageAlt: 'Superior Double Room at Casa Roca Canggu — queen bed with private balcony',
    description: 'Queen bed, private balcony, en-suite rain shower bathroom, AC, and 4K Smart TV. Ideal for couples and solo travelers.',
    price: 'IDR 750,000',
    tags: [
      { icon: 'wifi', label: 'Free Wi-Fi' },
      { icon: 'ac_unit', label: 'Climate Control' },
      { icon: 'balcony', label: 'Private Balcony' },
    ],
  },
  {
    name: 'Superior Twin Room',
    image: '/images/superior-twin-room.jpg',
    imageAlt: 'Superior Twin Room at Casa Roca Canggu — two single beds with private balcony',
    description: 'Two single beds, the same premium finishes and private balcony as the Double. Ideal for friends or surf buddies.',
    price: 'IDR 850,000',
    tags: [
      { icon: 'wifi', label: 'Free Wi-Fi' },
      { icon: 'ac_unit', label: 'Climate Control' },
      { icon: 'balcony', label: 'Private Balcony' },
    ],
  },
  {
    name: 'Deluxe Triple Room',
    image: '/images/deluxe-room.jpg',
    imageAlt: 'Deluxe Triple Room at Casa Roca Canggu — king bed and single bed with expanded balcony',
    description: 'Our most generous layout at 32m² — a king bed plus a single bed, sleeping up to 3 guests, with an expanded balcony.',
    price: 'IDR 1,150,000',
    tags: [
      { icon: 'balcony', label: 'Expanded Balcony' },
      { icon: 'shower', label: 'Rain Shower' },
      { icon: 'local_parking', label: 'Free Parking' },
    ],
  },
];

// This booking panel is a static visual mockup — it is not wired to a live
// PMS/channel manager, so no real availability or pricing is pulled here.
// The month shown is computed at build time so it never shows a stale year;
// wire up a real booking engine (e.g. Little Hotelier, Cloudbeds) here before
// treating this page as a functional booking flow.
const now = new Date();
const calendarMonthName = now.toLocaleString('en-US', { month: 'long' });
const calendarYear = now.getFullYear();
const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
const firstWeekdayMondayIndexed = (new Date(now.getFullYear(), now.getMonth(), 1).getDay() + 6) % 7;
const leadingBlankDays = Array.from({ length: firstWeekdayMondayIndexed });
const monthDays = Array.from({ length: daysInMonth }, (_, i) => i + 1);
---

<BaseLayout
  title="Book a Room at Casa Roca Canggu | Best Rate Direct"
  description="Check available dates and book your room at Casa Roca Canggu. Direct bookings get the lowest rate. Superior and Deluxe rooms on Jl. Batu Bolong, Canggu, Bali."
  canonical="https://casarocacanggu.com/availability"
>
  <Header />

  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">

    <!-- Hero -->
    <header class="pt-16 pb-12 md:pt-24 md:pb-16 text-center">
      <h1 class="font-headline-xl-mobile md:font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-surface mb-6">
        Book a Room at Casa Roca
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
        Secure your private sanctuary in the heart of Canggu. Book direct for our best guaranteed
        rates no OTA fees, no markup.
      </p>
    </header>

    <!-- Booking Engine -->
    <section class="mb-section-gap">
      <div class="w-full min-h-[600px] bg-surface-container-low rounded-xl overflow-hidden border border-outline-variant/30 flex flex-col">

        <!-- Engine header bar -->
        <div class="bg-surface-container-high px-8 py-4 flex justify-between items-center">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-secondary">calendar_today</span>
            <span class="font-label-md text-label-md text-on-surface">Omni Hotelier Secure Booking</span>
          </div>
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-outline-variant"></div>
            <div class="w-3 h-3 rounded-full bg-outline-variant"></div>
            <div class="w-3 h-3 rounded-full bg-outline-variant"></div>
          </div>
        </div>

        <!-- Booking engine iframe area -->
        <div class="flex-grow p-8 md:p-12 relative" style="background-image: radial-gradient(circle at 2px 2px, #e4e2e1 1px, transparent 0); background-size: 24px 24px;">
          <div class="max-w-4xl mx-auto space-y-12">

            <!-- Calendar + Summary -->
            <div class="bg-surface rounded-xl p-8 border border-outline-variant/20">
              <div class="flex flex-col md:flex-row gap-8">

                <!-- Calendar -->
                <div class="flex-grow">
                  <div class="flex items-center justify-between mb-6">
                    <h3 class="font-headline-md text-headline-md text-on-surface">{calendarMonthName} {calendarYear}</h3>
                    <div class="flex gap-2">
                      <button class="p-2 hover:bg-surface-container-low rounded-full transition-colors" aria-label="Previous month">
                        <span class="material-symbols-outlined">chevron_left</span>
                      </button>
                      <button class="p-2 hover:bg-surface-container-low rounded-full transition-colors" aria-label="Next month">
                        <span class="material-symbols-outlined">chevron_right</span>
                      </button>
                    </div>
                  </div>

                  <!-- Day headers -->
                  <div class="grid grid-cols-7 gap-2 text-center mb-2">
                    {['Mo','Tu','We','Th','Fr','Sa','Su'].map(d => (
                      <div class="font-label-sm text-label-sm text-outline uppercase">{d}</div>
                    ))}
                  </div>

                  <!-- Days: computed for the current month at build time so this
                       never shows a stale year. No real availability data is
                       plugged in yet — every day renders the same "available" style. -->
                  <div class="grid grid-cols-7 gap-2" id="calendar-days">
                    {leadingBlankDays.map(() => (
                      <div class="h-12"></div>
                    ))}
                    {monthDays.map(d => (
                      <div class="h-12 flex items-center justify-center font-body-md text-on-surface hover:bg-secondary-container rounded-lg cursor-pointer transition-colors cal-day" data-day={d}>{d}</div>
                    ))}
                  </div>
                </div>

                <!-- Summary -->
                <div class="md:w-64 flex flex-col justify-between border-t md:border-t-0 md:border-l border-outline-variant/20 pt-6 md:pt-0 md:pl-8">
                  <div class="space-y-6">
                    <div>
                      <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider block mb-1">Selected Stay</label>
                      <div class="font-body-md text-body-md text-on-surface" id="selected-stay">Select your dates</div>
                      <div class="font-label-sm text-label-sm text-secondary mt-1" id="nights-count">&nbsp;</div>
                    </div>
                    <div>
                      <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider block mb-1">Guests</label>
                      <div class="flex items-center justify-between">
                        <span class="font-body-md text-body-md text-on-surface">2 Adults</span>
                        <button class="text-secondary font-label-sm text-label-sm hover:underline">Edit</button>
                      </div>
                    </div>
                    <div class="pt-4 border-t border-outline-variant/20">
                      <p class="font-label-sm text-label-sm text-on-surface-variant">
                        Tap a date to start, or message us on WhatsApp to check availability directly.
                      </p>
                    </div>
                  </div>
                  <button class="bg-secondary text-on-secondary w-full rounded-lg font-label-md text-label-md py-4 mt-8 hover:opacity-90 transition-all active:scale-95">
                    Check Availability
                  </button>
                </div>
              </div>
            </div>

            <!-- Room Selection -->
            <div class="grid grid-cols-1 gap-6">
              {rooms.map((room) => (
                <div class="bg-surface rounded-lg overflow-hidden flex flex-col md:flex-row border border-outline-variant/20 group hover:shadow-md transition-shadow">
                  <div class="w-full md:w-80 h-64 md:h-auto overflow-hidden shrink-0">
                    <img
                      src={room.image}
                      alt={room.imageAlt}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-8 flex-grow flex flex-col justify-between">
                    <div>
                      <div class="flex justify-between items-start mb-2">
                        <h3 class="font-headline-md text-headline-md text-on-surface">{room.name}</h3>
                        <div class="text-right shrink-0 ml-4">
                          <div class="font-headline-md text-headline-md text-secondary">
                            {room.price}
                            <span class="font-label-sm font-normal text-on-surface-variant"> /night</span>
                          </div>
                        </div>
                      </div>
                      <p class="font-body-md text-body-md text-on-surface-variant mb-6">
                        {room.description}
                      </p>
                      <div class="flex gap-3 flex-wrap">
                        {room.tags.map(({ icon, label }) => (
                          <span class="flex items-center gap-1 font-label-sm text-label-sm text-on-tertiary-container bg-tertiary-container px-2 py-1 rounded">
                            <span class="material-symbols-outlined text-[16px]">{icon}</span>
                            {label}
                          </span>
                        ))}
                      </div>
                    </div>
                    <button
                      class="select-room-btn mt-8 border border-secondary text-secondary hover:bg-secondary hover:text-on-secondary px-8 py-3 rounded-lg font-label-md text-label-md transition-all self-start"
                    >
                      Select Room
                    </button>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- Why Book Direct -->
    <section class="mb-section-gap grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-8">Why book direct?</h2>
        <div class="space-y-8">
          {whyDirectPoints.map(({ icon, title, body }) => (
            <div class="flex gap-4">
              <div class="bg-secondary-container w-12 h-12 rounded-full flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-on-secondary-container">{icon}</span>
              </div>
              <div>
                <h4 class="font-label-md text-label-md text-on-surface mb-1">{title}</h4>
                <p class="font-body-md text-body-md text-on-surface-variant">{body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- WhatsApp card -->
      <div class="bg-primary-container p-12 rounded-xl border border-outline-variant/30 flex flex-col items-center text-center">
        <span class="material-symbols-outlined text-secondary mb-6" style="font-size:48px">chat_bubble</span>
        <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Prefer to ask first?</h3>
        <p class="font-body-md text-body-md text-on-surface-variant mb-8 max-w-sm">
          Our team is available via WhatsApp to answer questions about group bookings, special
          events, or room details. We reply within the hour.
        </p>
        <a
          href="https://wa.me/62XXXXXXXXX"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-secondary text-on-secondary px-10 py-4 rounded-full font-label-md text-label-md flex items-center gap-2 hover:opacity-90 transition-opacity"
        >
          <span class="material-symbols-outlined text-[20px]">chat</span>
          Chat on WhatsApp
        </a>
        <p class="mt-4 font-label-sm text-label-sm text-outline">Response time typically under 15 minutes.</p>
      </div>
    </section>

  </main>

  <Footer />

</BaseLayout>

<script>
  // Select Room button micro-interaction
  document.querySelectorAll('.select-room-btn').forEach((btn) => {
    btn.addEventListener('click', function () {
      const original = this.textContent.trim();
      this.textContent = 'Added ✓';
      this.classList.add('bg-secondary', 'text-on-secondary');
      setTimeout(() => {
        this.textContent = original;
        this.classList.remove('bg-secondary', 'text-on-secondary');
      }, 2000);
    });
  });
</script>