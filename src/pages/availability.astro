---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { rooms as roomData } from '../data/rooms';
import { property } from '../data/property';

const whyDirectPoints = [
  {
    icon: 'verified',
    title: 'Best Rate Guarantee',
    body: 'We promise the lowest price when you book through our website. No hidden commissions or OTA markups.',
  },
  {
    icon: 'event_available',
    title: 'Free Cancellation',
    body: `Free cancellation up to ${property.cancellationPolicy.freeUntilHoursBeforeCheckIn} hours before check-in when you book direct with us.`,
  },
  {
    icon: 'schedule',
    title: 'Priority Early Check-in',
    body: 'Direct guests get first priority for room availability upon arrival, subject to occupancy.',
  },
];

// Room data (name/price/images/capacity) now comes from the shared source in
// src/data/rooms.ts — see that file's comment for why this matters: this
// page used to hard-code its own separate room list that had drifted to
// different prices and a different room lineup than /rooms.
const rooms = roomData.map((room) => ({
  id: room.id,
  name: room.name,
  image: room.image,
  imageAlt: room.imageAlt,
  description: room.shortDescription,
  priceValue: room.priceValue,
  maxGuests: room.capacity,
  tags: room.quickTags,
}));

// Real availability calendar, embedded from the property's own booking
// system. This is view-only — guests check dates here, then book by
// messaging us on WhatsApp (see the CTA right below the embed, and the
// WhatsApp card further down this page).
const AVAILABILITY_EMBED_URL = 'https://ical.casarocacanggu.com/?embed=1';
---

<BaseLayout
  title="Book a Room at Casa Roca Canggu | Best Rate Direct"
  description="Check available dates and book your room at Casa Roca Canggu. Direct bookings get the lowest rate. Superior and Deluxe rooms on Jl. Batu Bolong, Canggu, Bali."
  canonical="https://casarocacanggu.com/availability"
>
  <Header />

  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">

    <!-- Hero -->
    <header class="pt-16 pb-12 md:pt-24 md:pb-16 text-center">
      <h1 class="font-headline-xl-mobile md:font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-surface mb-6">
        Book a Room at Casa Roca
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
        Secure your private sanctuary in the heart of Canggu. Book direct for our best guaranteed
        rates no OTA fees, no markup.
      </p>
    </header>

    <!-- Booking Engine -->
    <section class="mb-section-gap">
      <div class="w-full min-h-[600px] bg-surface-container-low rounded-xl overflow-hidden border border-outline-variant/30 flex flex-col">

        <!-- Engine header bar -->
        <div class="bg-surface-container-high px-8 py-4 flex justify-between items-center">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-secondary">calendar_today</span>
            <span class="font-label-md text-label-md text-on-surface">Casa Roca Direct Booking</span>
          </div>
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-outline-variant"></div>
            <div class="w-3 h-3 rounded-full bg-outline-variant"></div>
            <div class="w-3 h-3 rounded-full bg-outline-variant"></div>
          </div>
        </div>

        <!-- Booking engine iframe area -->
        <div class="flex-grow p-8 md:p-12 relative" style="background-image: radial-gradient(circle at 2px 2px, #e4e2e1 1px, transparent 0); background-size: 24px 24px;">
          <div class="max-w-4xl mx-auto space-y-12">

            <!-- Live availability calendar (real booking system) -->
            <div id="availability-embed" class="bg-surface rounded-xl p-4 md:p-6 border border-outline-variant/20">
              <div id="casa-roca-availability">
                <iframe
                  id="casa-roca-iframe"
                  src={AVAILABILITY_EMBED_URL}
                  style="width:100%; border:0; display:block; min-height:600px;"
                  loading="lazy"
                  title="Casa Roca Canggu Availability Calendar"
                ></iframe>
              </div>

              <!-- Booking happens via WhatsApp, not through this calendar directly:
                   check dates above, then message us to confirm. -->
              <div class="mt-4 pt-4 border-t border-outline-variant/20 flex flex-col sm:flex-row items-center justify-between gap-4">
                <p class="font-body-md text-body-md text-on-surface-variant text-center sm:text-left">
                  Found dates that work? Message us on WhatsApp with your dates to confirm your booking.
                </p>
                <a
                  href={`https://wa.me/${property.whatsapp}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="shrink-0 inline-flex items-center justify-center gap-2 bg-secondary text-on-secondary px-6 py-3 rounded-lg font-label-md text-label-md hover:opacity-90 transition-opacity"
                >
                  <span class="material-symbols-outlined text-[20px]">chat</span>
                  Book via WhatsApp
                </a>
              </div>
            </div>

            <!-- Room Selection -->
            <div class="grid grid-cols-1 gap-6">
              {rooms.map((room) => (
                <div
                  class="room-card bg-surface rounded-lg overflow-hidden flex flex-col md:flex-row border border-outline-variant/20 group hover:shadow-md transition-shadow"
                  data-room-id={room.id}
                  data-room-name={room.name}
                  data-room-price={room.priceValue}
                  data-max-guests={room.maxGuests}
                >
                  <div class="w-full md:w-80 h-64 md:h-auto overflow-hidden shrink-0">
                    <img
                      src={room.image}
                      alt={room.imageAlt}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-8 flex-grow flex flex-col justify-between">
                    <div>
                      <div class="flex justify-between items-start mb-2">
                        <h3 class="font-headline-md text-headline-md text-on-surface">{room.name}</h3>
                        <div class="text-right shrink-0 ml-4">
                          <div class="font-headline-md text-headline-md text-secondary">
                            IDR {room.priceValue.toLocaleString('en-US')}
                            <span class="font-label-sm font-normal text-on-surface-variant"> /night</span>
                          </div>
                        </div>
                      </div>
                      <p class="font-body-md text-body-md text-on-surface-variant mb-6">
                        {room.description}
                      </p>
                      <div class="flex gap-3 flex-wrap">
                        {room.tags.map(({ icon, label }) => (
                          <span class="flex items-center gap-1 font-label-sm text-label-sm text-on-tertiary-container bg-tertiary-container px-2 py-1 rounded">
                            <span class="material-symbols-outlined text-[16px]">{icon}</span>
                            {label}
                          </span>
                        ))}
                      </div>
                    </div>
                    <button
                      type="button"
                      class="select-room-btn mt-8 border border-secondary text-secondary hover:bg-secondary hover:text-on-secondary px-8 py-3 rounded-lg font-label-md text-label-md transition-all self-start"
                      data-room-id={room.id}
                    >
                      Check Dates for {room.name.split(' ')[0]} {room.name.split(' ')[1]}
                    </button>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- Why Book Direct -->
    <section class="mb-section-gap grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-8">Why book direct?</h2>
        <div class="space-y-8">
          {whyDirectPoints.map(({ icon, title, body }) => (
            <div class="flex gap-4">
              <div class="bg-secondary-container w-12 h-12 rounded-full flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-on-secondary-container">{icon}</span>
              </div>
              <div>
                <h4 class="font-label-md text-label-md text-on-surface mb-1">{title}</h4>
                <p class="font-body-md text-body-md text-on-surface-variant">{body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- WhatsApp card -->
      <div class="bg-primary-container p-12 rounded-xl border border-outline-variant/30 flex flex-col items-center text-center">
        <span class="material-symbols-outlined text-secondary mb-6" style="font-size:48px">chat_bubble</span>
        <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Prefer to ask first?</h3>
        <p class="font-body-md text-body-md text-on-surface-variant mb-8 max-w-sm">
          Our team is available via WhatsApp to answer questions about group bookings, special
          events, or room details. We reply within the hour.
        </p>
        <a
          href={`https://wa.me/${property.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-secondary text-on-secondary px-10 py-4 rounded-full font-label-md text-label-md flex items-center gap-2 hover:opacity-90 transition-opacity"
        >
          <span class="material-symbols-outlined text-[20px]">chat</span>
          Chat on WhatsApp
        </a>
        <p class="mt-4 font-label-sm text-label-sm text-outline">Response time typically under 15 minutes.</p>
      </div>
    </section>

  </main>

  <Footer />

</BaseLayout>

<script>
  // Real availability calendar embed. The iframe posts its content height so
  // we can resize the wrapper to fit (no internal scrollbar).
  window.addEventListener('message', function (e) {
    if (e.data && typeof e.data.casaRocaAvailabilityHeight === 'number') {
      var iframe = document.getElementById('casa-roca-iframe');
      if (iframe) iframe.style.height = e.data.casaRocaAvailabilityHeight + 'px';
    }
  });

  // Each room card's "Check Dates" button scrolls to the calendar above —
  // booking itself happens via the WhatsApp CTA next to the calendar, not
  // through this page directly.
  document.querySelectorAll('.select-room-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.getElementById('availability-embed')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
