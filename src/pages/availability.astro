---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const whyDirectPoints = [
  {
    icon: 'verified',
    title: 'Best Rate Guarantee',
    body: 'We promise the lowest price when you book through our website. No hidden commissions or OTA markups.',
  },
  {
    icon: 'event_available',
    title: 'Free Cancellation',
    body: 'Free cancellation up to 48 hours before check-in when you book direct with us.',
  },
  {
    icon: 'schedule',
    title: 'Priority Early Check-in',
    body: 'Direct guests get first priority for room availability upon arrival, subject to occupancy.',
  },
];

// Kept in sync with the room data on /rooms — see src/pages/rooms.astro.
// priceValue/maxGuests are numeric so the client-side script below can do
// nights × rate math and cap the guest stepper per room.
// ids match the room ids used on /rooms and in the search-bar query params
// (?room=double|twin|triple) so a link from elsewhere can pre-select a room.
const rooms = [
  {
    id: 'double',
    name: 'Superior Double Room',
    image: '/images/superior-double-room.jpg',
    imageAlt: 'Superior Double Room at Casa Roca Canggu — queen bed with private balcony',
    description: 'Queen bed, private balcony, en-suite rain shower bathroom, AC, and 4K Smart TV. Ideal for couples and solo travelers.',
    priceValue: 750000,
    maxGuests: 2,
    tags: [
      { icon: 'wifi', label: 'Free Wi-Fi' },
      { icon: 'ac_unit', label: 'Climate Control' },
      { icon: 'balcony', label: 'Private Balcony' },
    ],
  },
  {
    id: 'twin',
    name: 'Superior Twin Room',
    image: '/images/superior-twin-room.jpg',
    imageAlt: 'Superior Twin Room at Casa Roca Canggu — two single beds with private balcony',
    description: 'Two single beds, the same premium finishes and private balcony as the Double. Ideal for friends or surf buddies.',
    priceValue: 850000,
    maxGuests: 2,
    tags: [
      { icon: 'wifi', label: 'Free Wi-Fi' },
      { icon: 'ac_unit', label: 'Climate Control' },
      { icon: 'balcony', label: 'Private Balcony' },
    ],
  },
  {
    id: 'triple',
    name: 'Deluxe Triple Room',
    image: '/images/deluxe-room.jpg',
    imageAlt: 'Deluxe Triple Room at Casa Roca Canggu — king bed and single bed with expanded balcony',
    description: 'Our most generous layout at 32m² — a king bed plus a single bed, sleeping up to 3 guests, with an expanded balcony.',
    priceValue: 1150000,
    maxGuests: 3,
    tags: [
      { icon: 'balcony', label: 'Expanded Balcony' },
      { icon: 'shower', label: 'Rain Shower' },
      { icon: 'local_parking', label: 'Free Parking' },
    ],
  },
];

// This booking panel is a real interactive date/room/price calculator, but it
// is not wired to a live PMS/channel manager — there is no source of true
// availability yet, so UNAVAILABLE_DATES below (in the client script) is an
// empty illustrative placeholder, not real booked-out data. Wire up a real
// booking engine (e.g. Little Hotelier, Cloudbeds) to replace it before
// relying on this page for real reservations. The month shown server-side is
// computed at request/build time so it never shows a stale year; the client
// script takes over immediately for month navigation and selection.
const now = new Date();
const calendarMonthName = now.toLocaleString('en-US', { month: 'long' });
const calendarYear = now.getFullYear();
const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
const firstWeekdayMondayIndexed = (new Date(now.getFullYear(), now.getMonth(), 1).getDay() + 6) % 7;
const leadingBlankDays = Array.from({ length: firstWeekdayMondayIndexed });
const monthDays = Array.from({ length: daysInMonth }, (_, i) => i + 1);
---

<BaseLayout
  title="Book a Room at Casa Roca Canggu | Best Rate Direct"
  description="Check available dates and book your room at Casa Roca Canggu. Direct bookings get the lowest rate. Superior and Deluxe rooms on Jl. Batu Bolong, Canggu, Bali."
  canonical="https://casarocacanggu.com/availability"
>
  <Header />

  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">

    <!-- Hero -->
    <header class="pt-16 pb-12 md:pt-24 md:pb-16 text-center">
      <h1 class="font-headline-xl-mobile md:font-headline-xl text-headline-xl-mobile md:text-headline-xl text-on-surface mb-6">
        Book a Room at Casa Roca
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
        Secure your private sanctuary in the heart of Canggu. Book direct for our best guaranteed
        rates no OTA fees, no markup.
      </p>
    </header>

    <!-- Booking Engine -->
    <section class="mb-section-gap">
      <div class="w-full min-h-[600px] bg-surface-container-low rounded-xl overflow-hidden border border-outline-variant/30 flex flex-col">

        <!-- Engine header bar -->
        <div class="bg-surface-container-high px-8 py-4 flex justify-between items-center">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-secondary">calendar_today</span>
            <span class="font-label-md text-label-md text-on-surface">Casa Roca Direct Booking</span>
          </div>
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-outline-variant"></div>
            <div class="w-3 h-3 rounded-full bg-outline-variant"></div>
            <div class="w-3 h-3 rounded-full bg-outline-variant"></div>
          </div>
        </div>

        <!-- Booking engine iframe area -->
        <div class="flex-grow p-8 md:p-12 relative" style="background-image: radial-gradient(circle at 2px 2px, #e4e2e1 1px, transparent 0); background-size: 24px 24px;">
          <div class="max-w-4xl mx-auto space-y-12">

            <!-- Calendar + Summary -->
            <div class="bg-surface rounded-xl p-8 border border-outline-variant/20">
              <div class="flex flex-col md:flex-row gap-8">

                <!-- Calendar -->
                <div class="flex-grow">
                  <div class="flex items-center justify-between mb-6">
                    <h3 class="font-headline-md text-headline-md text-on-surface" id="calendar-month-label">{calendarMonthName} {calendarYear}</h3>
                    <div class="flex gap-2">
                      <button type="button" id="cal-prev" class="p-2 hover:bg-surface-container-low rounded-full transition-colors" aria-label="Previous month">
                        <span class="material-symbols-outlined">chevron_left</span>
                      </button>
                      <button type="button" id="cal-next" class="p-2 hover:bg-surface-container-low rounded-full transition-colors" aria-label="Next month">
                        <span class="material-symbols-outlined">chevron_right</span>
                      </button>
                    </div>
                  </div>

                  <!-- Day headers -->
                  <div class="grid grid-cols-7 gap-2 text-center mb-2">
                    {['Mo','Tu','We','Th','Fr','Sa','Su'].map(d => (
                      <div class="font-label-sm text-label-sm text-outline uppercase">{d}</div>
                    ))}
                  </div>

                  <!-- Days: computed for the current month at build time so this
                       never shows a stale year. No real availability data is
                       plugged in yet — every day renders the same "available" style. -->
                  <div class="grid grid-cols-7 gap-2" id="calendar-days">
                    {leadingBlankDays.map(() => (
                      <div class="h-12"></div>
                    ))}
                    {monthDays.map(d => (
                      <div class="h-12 flex items-center justify-center font-body-md text-on-surface hover:bg-secondary-container rounded-lg cursor-pointer transition-colors cal-day" data-day={d}>{d}</div>
                    ))}
                  </div>
                </div>

                <!-- Summary -->
                <div class="md:w-64 flex flex-col justify-between border-t md:border-t-0 md:border-l border-outline-variant/20 pt-6 md:pt-0 md:pl-8">
                  <div class="space-y-6">
                    <div>
                      <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider block mb-1">Selected Stay</label>
                      <div class="font-body-md text-body-md text-on-surface" id="selected-stay">Select your dates</div>
                      <div class="font-label-sm text-label-sm text-secondary mt-1" id="nights-count">&nbsp;</div>
                    </div>
                    <div>
                      <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider block mb-1">Guests</label>
                      <div class="flex items-center justify-between">
                        <button type="button" id="guests-minus" aria-label="Fewer guests" class="w-7 h-7 flex items-center justify-center rounded-full border border-outline-variant text-on-surface hover:bg-secondary-container transition-colors">−</button>
                        <span class="font-body-md text-body-md text-on-surface" id="guests-count">2 Adults</span>
                        <button type="button" id="guests-plus" aria-label="More guests" class="w-7 h-7 flex items-center justify-center rounded-full border border-outline-variant text-on-surface hover:bg-secondary-container transition-colors">+</button>
                      </div>
                    </div>
                    <div class="pt-4 border-t border-outline-variant/20">
                      <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider block mb-1">Room</label>
                      <div class="font-body-md text-body-md text-on-surface" id="summary-room">No room selected</div>
                      <div class="font-label-sm text-label-sm text-on-surface-variant mt-1" id="summary-nightly">&nbsp;</div>
                    </div>
                    <div id="summary-total-row" class="pt-4 border-t border-outline-variant/20 hidden">
                      <label class="font-label-sm text-label-sm text-outline uppercase tracking-wider block mb-1">Estimated Total</label>
                      <div class="font-headline-sm text-headline-sm text-secondary" id="summary-total"></div>
                    </div>
                  </div>
                  <div>
                    <p id="booking-notice" class="font-label-sm text-label-sm text-red-600 mt-4 hidden"></p>
                    <button id="check-availability-btn" type="button" class="bg-secondary text-on-secondary w-full rounded-lg font-label-md text-label-md py-4 mt-4 hover:opacity-90 transition-all active:scale-95">
                      Check Availability
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Room Selection -->
            <div class="grid grid-cols-1 gap-6">
              {rooms.map((room) => (
                <div
                  class="room-card bg-surface rounded-lg overflow-hidden flex flex-col md:flex-row border border-outline-variant/20 group hover:shadow-md transition-shadow"
                  data-room-id={room.id}
                  data-room-name={room.name}
                  data-room-price={room.priceValue}
                  data-max-guests={room.maxGuests}
                >
                  <div class="w-full md:w-80 h-64 md:h-auto overflow-hidden shrink-0">
                    <img
                      src={room.image}
                      alt={room.imageAlt}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-8 flex-grow flex flex-col justify-between">
                    <div>
                      <div class="flex justify-between items-start mb-2">
                        <h3 class="font-headline-md text-headline-md text-on-surface">{room.name}</h3>
                        <div class="text-right shrink-0 ml-4">
                          <div class="font-headline-md text-headline-md text-secondary">
                            IDR {room.priceValue.toLocaleString('en-US')}
                            <span class="font-label-sm font-normal text-on-surface-variant"> /night</span>
                          </div>
                        </div>
                      </div>
                      <p class="font-body-md text-body-md text-on-surface-variant mb-6">
                        {room.description}
                      </p>
                      <div class="flex gap-3 flex-wrap">
                        {room.tags.map(({ icon, label }) => (
                          <span class="flex items-center gap-1 font-label-sm text-label-sm text-on-tertiary-container bg-tertiary-container px-2 py-1 rounded">
                            <span class="material-symbols-outlined text-[16px]">{icon}</span>
                            {label}
                          </span>
                        ))}
                      </div>
                    </div>
                    <button
                      type="button"
                      class="select-room-btn mt-8 border border-secondary text-secondary hover:bg-secondary hover:text-on-secondary px-8 py-3 rounded-lg font-label-md text-label-md transition-all self-start"
                    >
                      Select Room
                    </button>
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- Why Book Direct -->
    <section class="mb-section-gap grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-8">Why book direct?</h2>
        <div class="space-y-8">
          {whyDirectPoints.map(({ icon, title, body }) => (
            <div class="flex gap-4">
              <div class="bg-secondary-container w-12 h-12 rounded-full flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-on-secondary-container">{icon}</span>
              </div>
              <div>
                <h4 class="font-label-md text-label-md text-on-surface mb-1">{title}</h4>
                <p class="font-body-md text-body-md text-on-surface-variant">{body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- WhatsApp card -->
      <div class="bg-primary-container p-12 rounded-xl border border-outline-variant/30 flex flex-col items-center text-center">
        <span class="material-symbols-outlined text-secondary mb-6" style="font-size:48px">chat_bubble</span>
        <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Prefer to ask first?</h3>
        <p class="font-body-md text-body-md text-on-surface-variant mb-8 max-w-sm">
          Our team is available via WhatsApp to answer questions about group bookings, special
          events, or room details. We reply within the hour.
        </p>
        <a
          href="https://wa.me/62XXXXXXXXX"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-secondary text-on-secondary px-10 py-4 rounded-full font-label-md text-label-md flex items-center gap-2 hover:opacity-90 transition-opacity"
        >
          <span class="material-symbols-outlined text-[20px]">chat</span>
          Chat on WhatsApp
        </a>
        <p class="mt-4 font-label-sm text-label-sm text-outline">Response time typically under 15 minutes.</p>
      </div>
    </section>

  </main>

  <Footer />

</BaseLayout>

<script>
  // Casa Roca booking widget: real client-side date/room/price logic.
  // There is no live PMS behind this yet — UNAVAILABLE_DATES is an empty
  // illustrative placeholder, not real booked-out inventory. Replace it (and
  // the WhatsApp hand-off at the bottom) with a real booking engine when one
  // is connected.
  const WHATSAPP_NUMBER = '62XXXXXXXXX';
  const UNAVAILABLE_DATES = []; // e.g. ['2026-10-05', '2026-10-06']

  const monthLabelEl = document.getElementById('calendar-month-label');
  const daysGridEl = document.getElementById('calendar-days');
  const prevBtn = document.getElementById('cal-prev');
  const nextBtn = document.getElementById('cal-next');
  const selectedStayEl = document.getElementById('selected-stay');
  const nightsCountEl = document.getElementById('nights-count');
  const guestsCountEl = document.getElementById('guests-count');
  const guestsMinusBtn = document.getElementById('guests-minus');
  const guestsPlusBtn = document.getElementById('guests-plus');
  const roomCards = document.querySelectorAll('.room-card');
  const summaryRoomEl = document.getElementById('summary-room');
  const summaryNightlyEl = document.getElementById('summary-nightly');
  const summaryTotalRow = document.getElementById('summary-total-row');
  const summaryTotalEl = document.getElementById('summary-total');
  const checkAvailabilityBtn = document.getElementById('check-availability-btn');
  const bookingNoticeEl = document.getElementById('booking-notice');

  if (daysGridEl && monthLabelEl && prevBtn && nextBtn && checkAvailabilityBtn) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    let viewYear = today.getFullYear();
    let viewMonth = today.getMonth(); // 0-indexed
    let checkIn = null;   // Date
    let checkOut = null;  // Date
    let selectedRoom = null; // { name, price, maxGuests }
    let guests = 2;

    const idr = (n) => `IDR ${n.toLocaleString('en-US')}`;
    const toISODate = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const isUnavailable = (d) => UNAVAILABLE_DATES.includes(toISODate(d));
    const isPast = (d) => d < today;
    const isSameDay = (a, b) => !!a && !!b && a.getTime() === b.getTime();
    const isInRange = (d) => !!checkIn && !!checkOut && d > checkIn && d < checkOut;
    const nightsBetween = (a, b) => Math.round((b - a) / 86400000);
    const formatShort = (d) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

    function hasBlockedBetween(start, end) {
      const cursor = new Date(start);
      cursor.setDate(cursor.getDate() + 1);
      while (cursor < end) {
        if (isUnavailable(cursor)) return true;
        cursor.setDate(cursor.getDate() + 1);
      }
      return false;
    }

    function renderCalendar() {
      monthLabelEl.textContent = new Date(viewYear, viewMonth, 1).toLocaleString('en-US', { month: 'long', year: 'numeric' });
      daysGridEl.innerHTML = '';

      const firstWeekday = (new Date(viewYear, viewMonth, 1).getDay() + 6) % 7; // Monday = 0
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

      for (let i = 0; i < firstWeekday; i++) {
        const blank = document.createElement('div');
        blank.className = 'h-12';
        daysGridEl.appendChild(blank);
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const date = new Date(viewYear, viewMonth, day);
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.textContent = String(day);
        cell.className = 'h-12 flex items-center justify-center font-body-md rounded-lg transition-colors';

        const past = isPast(date);
        const blocked = isUnavailable(date);

        if (past || blocked) {
          cell.disabled = true;
          cell.classList.add('text-outline/40', 'line-through', 'cursor-not-allowed', 'bg-surface-container-low');
          if (blocked && !past) cell.title = 'Not available';
        } else {
          if (isSameDay(date, checkIn) || isSameDay(date, checkOut)) {
            cell.classList.add('bg-secondary', 'text-on-secondary', 'cursor-pointer');
          } else if (isInRange(date)) {
            cell.classList.add('bg-secondary-container', 'text-on-secondary-container', 'cursor-pointer');
          } else {
            cell.classList.add('text-on-surface', 'hover:bg-secondary-container', 'cursor-pointer');
          }
          cell.addEventListener('click', () => onDayClick(date));
        }

        daysGridEl.appendChild(cell);
      }
    }

    function onDayClick(date) {
      if (!checkIn || checkOut) {
        checkIn = date;
        checkOut = null;
      } else if (date <= checkIn || hasBlockedBetween(checkIn, date)) {
        checkIn = date;
        checkOut = null;
      } else {
        checkOut = date;
      }
      bookingNoticeEl.classList.add('hidden');
      updateSummary();
      renderCalendar();
    }

    function updateSummary() {
      if (checkIn && checkOut) {
        const nights = nightsBetween(checkIn, checkOut);
        selectedStayEl.textContent = `${formatShort(checkIn)} – ${formatShort(checkOut)}, ${checkOut.getFullYear()}`;
        nightsCountEl.textContent = `${nights} Night${nights > 1 ? 's' : ''}`;
      } else if (checkIn) {
        selectedStayEl.textContent = `${formatShort(checkIn)} — now pick a check-out date`;
        nightsCountEl.textContent = ' ';
      } else {
        selectedStayEl.textContent = 'Select your dates';
        nightsCountEl.textContent = ' ';
      }
      updateTotal();
    }

    function updateTotal() {
      if (!selectedRoom) {
        summaryRoomEl.textContent = 'No room selected';
        summaryNightlyEl.textContent = ' ';
        summaryTotalRow.classList.add('hidden');
        return;
      }
      summaryRoomEl.textContent = selectedRoom.name;
      summaryNightlyEl.textContent = `${idr(selectedRoom.price)} / night`;

      if (checkIn && checkOut) {
        const nights = nightsBetween(checkIn, checkOut);
        summaryTotalRow.classList.remove('hidden');
        // Nights > 1 scales linearly with the nightly rate; adjust here if
        // weekly/long-stay discounts are ever introduced.
        summaryTotalEl.textContent = `${idr(selectedRoom.price * nights)} for ${nights} night${nights > 1 ? 's' : ''}`;
      } else {
        summaryTotalRow.classList.add('hidden');
      }
    }

    function selectRoom(room, cardEl) {
      selectedRoom = room;
      roomCards.forEach((c) => c.classList.remove('ring-2', 'ring-secondary'));
      cardEl.classList.add('ring-2', 'ring-secondary');
      guests = Math.min(guests, room.maxGuests);
      updateGuestsLabel();
      updateTotal();
    }

    function updateGuestsLabel() {
      guestsCountEl.textContent = `${guests} ${guests === 1 ? 'Adult' : 'Adults'}`;
    }

    function selectRoomByCard(card) {
      const name = card.dataset.roomName;
      const price = Number(card.dataset.roomPrice);
      const maxGuests = Number(card.dataset.maxGuests);
      selectRoom({ name, price, maxGuests }, card);
    }

    roomCards.forEach((card) => {
      const btn = card.querySelector('.select-room-btn');
      if (!btn) return;
      btn.addEventListener('click', () => {
        selectRoomByCard(card);
        bookingNoticeEl.classList.add('hidden');
        const original = btn.textContent.trim();
        btn.textContent = 'Selected ✓';
        setTimeout(() => { btn.textContent = original; }, 2000);
      });
    });

    guestsMinusBtn?.addEventListener('click', () => {
      guests = Math.max(1, guests - 1);
      updateGuestsLabel();
    });
    guestsPlusBtn?.addEventListener('click', () => {
      const cap = selectedRoom?.maxGuests ?? 3;
      guests = Math.min(cap, guests + 1);
      updateGuestsLabel();
    });

    prevBtn.addEventListener('click', () => {
      viewMonth -= 1;
      if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
      renderCalendar();
    });
    nextBtn.addEventListener('click', () => {
      viewMonth += 1;
      if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
      renderCalendar();
    });

    checkAvailabilityBtn.addEventListener('click', () => {
      if (!checkIn || !checkOut) {
        bookingNoticeEl.textContent = 'Please select your check-in and check-out dates.';
        bookingNoticeEl.classList.remove('hidden');
        return;
      }
      if (!selectedRoom) {
        bookingNoticeEl.textContent = 'Please select a room type below.';
        bookingNoticeEl.classList.remove('hidden');
        return;
      }
      bookingNoticeEl.classList.add('hidden');

      const nights = nightsBetween(checkIn, checkOut);
      const total = selectedRoom.price * nights;
      const message = [
        "Hi Casa Roca, I'd like to check availability:",
        `Room: ${selectedRoom.name}`,
        `Check-in: ${formatShort(checkIn)} ${checkIn.getFullYear()}`,
        `Check-out: ${formatShort(checkOut)} ${checkOut.getFullYear()}`,
        `Nights: ${nights}`,
        `Guests: ${guests}`,
        `Estimated total: ${idr(total)}`,
      ].join('\n');

      window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`, '_blank', 'noopener');
    });

    // Pre-fill from a search elsewhere on the site (hero search bar, /rooms
    // filter bar, or a room card's "Reserve" link) instead of ignoring it —
    // e.g. /availability?checkin=2026-10-01&checkout=2026-10-03&room=twin&guests=2
    function applySearchParams() {
      const params = new URLSearchParams(window.location.search);
      const parseParamDate = (value) => {
        if (!value || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return null;
        const [y, m, d] = value.split('-').map(Number);
        const date = new Date(y, m - 1, d);
        return isPast(date) ? null : date;
      };

      const paramCheckIn = parseParamDate(params.get('checkin'));
      const paramCheckOut = parseParamDate(params.get('checkout'));
      if (paramCheckIn && paramCheckOut && paramCheckOut > paramCheckIn && !hasBlockedBetween(paramCheckIn, paramCheckOut)) {
        checkIn = paramCheckIn;
        checkOut = paramCheckOut;
        viewYear = checkIn.getFullYear();
        viewMonth = checkIn.getMonth();
      } else if (paramCheckIn) {
        checkIn = paramCheckIn;
        viewYear = checkIn.getFullYear();
        viewMonth = checkIn.getMonth();
      }

      const paramRoom = params.get('room');
      if (paramRoom) {
        const card = Array.from(roomCards).find((c) => c.dataset.roomId === paramRoom);
        if (card) selectRoomByCard(card);
      }

      const paramGuests = Number(params.get('guests'));
      if (Number.isInteger(paramGuests) && paramGuests > 0) {
        guests = selectedRoom ? Math.min(paramGuests, selectedRoom.maxGuests) : paramGuests;
      }
    }

    applySearchParams();
    updateGuestsLabel();
    renderCalendar();
    updateSummary();
  }
</script>