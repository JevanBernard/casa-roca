---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RoomCard from '../components/RoomCard.astro';
import AmenitiesGrid from '../components/AmenitiesGrid.astro';
import RoomComparisonTable from '../components/RoomComparisonTable.astro';
import StayPolicies from '../components/StayPolicies.astro';
import CTABanner from '../components/CTABanner.astro';

const rooms = [
  {
    id: 'double',
    roomCode: 'Room 01 – 03',
    name: 'Superior Double Room',
    tagline: 'Couples & Solo Travelers',
    badge: 'Most Popular for Couples & Solo Travelers',
    description:
      'Designed for a restorative rest after a day of surfing. Featuring a comfortable queen mattress, cool and cozy linens, and floor-to-ceiling glass doors that open directly onto your private balcony.',
    price: 'IDR 750,000',
    image: '/images/superior-double-room.jpg',
    imageAlt: 'Superior Double Room at Casa Roca Canggu — queen bed with private balcony',
    specs: [
      { icon: 'square_foot', label: '22 m²' },
      { icon: 'bed', label: '1 Queen Bed (160×200)' },
      { icon: 'person', label: 'Max 2 Guests' },
      { icon: 'shower', label: 'En-Suite Rain Shower' },
      { icon: 'deck', label: 'Private Balcony' },
    ],
    inclusions: [
      'Queen bed with orthopedic pocket-spring mattress',
      'Private balcony with garden & Batu Bolong view',
      'Private en-suite bathroom with rain shower & amenities',
      'Air conditioning with bedside remote controls',
      '32" 4K Smart TV',
      'High-speed dedicated fiber Wi-Fi (50+ Mbps)',
      'Free basement parking & daily housekeeping',
    ],
    reversed: false,
  },
  {
    id: 'twin',
    roomCode: 'Room 04 – 08',
    name: 'Superior Twin Room',
    tagline: 'Surf Buddies & Travel Friends',
    badge: 'Perfect for Surf Trips & Friends',
    description:
      'Two single beds ideal for two travelers or friends exploring Canggu together. Same premium finishes and private balcony as the Double, with the flexibility of two separate sleeping surfaces.',
    price: 'IDR 850,000',
    image: '/images/superior-twin-room.jpg',
    imageAlt: 'Superior Twin Room at Casa Roca Canggu — two single beds with private balcony',
    specs: [
      { icon: 'square_foot', label: '22 m²' },
      { icon: 'bed', label: '2 Single Beds (100×200)' },
      { icon: 'group', label: 'Max 2 Guests' },
      { icon: 'shower', label: 'En-Suite Rain Shower' },
      { icon: 'deck', label: 'Private Balcony' },
    ],
    inclusions: [
      '2 single beds with orthopedic pocket-spring mattresses',
      'Private balcony with garden & Batu Bolong view',
      'Private en-suite bathroom with rain shower & amenities',
      'Air conditioning with bedside remote controls',
      '32" 4K Smart TV',
      'High-speed dedicated fiber Wi-Fi (50+ Mbps)',
      'Free basement parking & daily housekeeping',
    ],
    reversed: true,
  },
  {
    id: 'triple',
    roomCode: 'Room 09 – 10',
    name: 'Deluxe Triple Room',
    tagline: 'Families & Extended Stays',
    badge: 'Expanded Living & Flexible Space',
    description:
      'Our most generous room layout at 32 square meters. A king bed plus a separate single bed comfortably accommodates up to 3 adults. Extra wardrobe space, more natural light, and a larger balcony lounge.',
    price: 'IDR 1,150,000',
    image: '/images/deluxe-room.jpg',
    imageAlt: 'Deluxe Triple Room at Casa Roca Canggu — king bed and single bed with expanded balcony',
    specs: [
      { icon: 'square_foot', label: '32 m²' },
      { icon: 'bed', label: '1 King + 1 Single Bed' },
      { icon: 'group', label: 'Sleeps Up to 3 Guests' },
      { icon: 'bathtub', label: 'Large En-Suite' },
      { icon: 'deck', label: 'Expanded Balcony' },
    ],
    inclusions: [
      '1 King Bed + 1 Single Bed with premium linen',
      'Expanded private balcony terrace',
      'Spacious en-suite bathroom with rain shower',
      'Extra wardrobe space & luggage storage',
      'High-speed Wi-Fi, silent inverter AC & 32" 4K Smart TV',
      'Free basement parking & daily housekeeping',
      'Direct host concierge assistance via WhatsApp',
    ],
    reversed: false,
  },
];

const schemaRooms = rooms.map((r) => ({
  '@context': 'https://schema.org',
  '@type': 'HotelRoom',
  name: r.name + ' — Casa Roca Canggu',
  description: r.description,
  occupancy: { '@type': 'QuantitativeValue', maxValue: r.id === 'triple' ? 3 : 2 },
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Private balcony',  value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Rain shower',       value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Air conditioning',  value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Flat screen TV',    value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Free WiFi',         value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Free parking',      value: true },
  ],
}));
---

<BaseLayout
  title="Rooms at Casa Roca Canggu — Superior Double, Superior Twin & Deluxe Triple"
  description="Browse Superior Double, Superior Twin, and Deluxe Triple rooms at Casa Roca Canggu. All rooms include private balcony, en-suite rain shower, AC, TV & free parking. Book direct for best rates."
  canonical="https://casarocacanggu.com/rooms"
>
  {schemaRooms.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} slot="head" />
  ))}

  <Header />

  <main class="w-full pt-20 bg-[#fcf9f4]">

    <!-- Page header -->
    <section class="max-w-[1360px] mx-auto px-5 lg:px-12 pt-10 pb-6">
      <div class="flex flex-col gap-3 max-w-4xl">
        <div class="flex items-center gap-1 text-[#6E5249]">
          <span class="material-symbols-outlined text-[16px]">holiday_village</span>
          <span class="text-[11px] font-[600] leading-[16px] tracking-[0.2em] uppercase">
            Casa Roca Canggu — Accommodations
          </span>
        </div>
        <h1 class="font-['Playfair_Display'] text-[40px] font-[400] leading-[48px] tracking-[-0.01em] text-[#1E1B18]">
          Private Sanctuaries Crafted for Rest & Renewal
        </h1>
        <p class="text-[16px] font-[400] leading-[26px] text-[#504441] max-w-2xl">
          Only 10 thoughtfully appointed private rooms on Jl. Batu Bolong. Each featuring a private
          balcony, en-suite rain shower, whisper-quiet AC, and dedicated basement parking —
          200 meters to the beach.
        </p>
      </div>

      <!-- Perks bar -->
      <div class="mt-8 p-4 bg-[#F3EFE8] rounded-xl shadow-sm flex flex-wrap items-center justify-between gap-3">
        {[
          { icon: 'lock',         label: '100% Private (No Shared Spaces)' },
          { icon: 'balcony',      label: 'Private Balcony in Every Room' },
          { icon: 'shower',       label: 'En-Suite Rain Shower' },
          { icon: 'local_parking',label: 'Free Secured Basement Parking' },
          { icon: 'surfing',      label: '200m Stroll to Batu Bolong Surf' },
        ].map(({ icon, label }) => (
          <div class="flex items-center gap-1 text-[#1E1B18]">
            <span class="material-symbols-outlined text-[#6E5249] text-[20px]">{icon}</span>
            <span class="text-[13px] font-[500]">{label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Quick filter bar -->
    <section class="max-w-[1360px] mx-auto px-5 lg:px-12 pb-16">
      <div class="p-6 bg-white rounded-xl shadow-md">
        <form class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4 items-end" onsubmit="event.preventDefault();filterRoomsUI()">

          <div class="lg:col-span-3 flex flex-col gap-1">
            <label class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63]">Check-in</label>
            <div class="flex items-center bg-[#F3EFE8] rounded px-4 py-2.5">
              <span class="material-symbols-outlined text-[#6E5249] text-[18px] mr-2">calendar_today</span>
              <input type="date" class="bg-transparent w-full text-[#1E1B18] text-[13px] font-[500] focus:outline-none" />
            </div>
          </div>

          <div class="lg:col-span-3 flex flex-col gap-1">
            <label class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63]">Check-out</label>
            <div class="flex items-center bg-[#F3EFE8] rounded px-4 py-2.5">
              <span class="material-symbols-outlined text-[#6E5249] text-[18px] mr-2">calendar_today</span>
              <input type="date" class="bg-transparent w-full text-[#1E1B18] text-[13px] font-[500] focus:outline-none" />
            </div>
          </div>

          <div class="lg:col-span-2 flex flex-col gap-1">
            <label class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63]">Room Type</label>
            <div class="flex items-center bg-[#F3EFE8] rounded px-4 py-2.5">
              <select id="roomFilterSelect" class="bg-transparent w-full text-[#1E1B18] text-[13px] font-[500] focus:outline-none cursor-pointer">
                <option value="all">All Room Types (3)</option>
                <option value="double">Superior Double</option>
                <option value="twin">Superior Twin</option>
                <option value="triple">Deluxe Triple</option>
              </select>
            </div>
          </div>

          <div class="lg:col-span-2 flex flex-col gap-1">
            <label class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63]">Guests</label>
            <div class="flex items-center bg-[#F3EFE8] rounded px-4 py-2.5">
              <span class="material-symbols-outlined text-[#6E5249] text-[18px] mr-2">group</span>
              <select class="bg-transparent w-full text-[#1E1B18] text-[13px] font-[500] focus:outline-none cursor-pointer">
                <option value="1">1 Guest</option>
                <option value="2" selected>2 Guests</option>
                <option value="3">3 Guests</option>
              </select>
            </div>
          </div>

          <div class="lg:col-span-2 flex flex-col justify-end">
            <button type="submit" class="w-full flex items-center justify-center gap-1 py-3 px-4 bg-[#6E5249] hover:bg-[#553b33] text-white rounded text-[13px] font-[500] shadow-sm transition-all">
              <span class="material-symbols-outlined text-[18px]">search</span>
              <span>Check Rates</span>
            </button>
          </div>

        </form>
      </div>
    </section>

    <!-- Room cards -->
    <section class="max-w-[1360px] mx-auto px-5 lg:px-12 pb-24">
      <div class="flex flex-col gap-16" id="rooms-list">
        {rooms.map((room) => <RoomCard {...room} />)}
      </div>
    </section>

    <AmenitiesGrid />
    <RoomComparisonTable />
    <StayPolicies />
    <CTABanner
      title="Ready to book your room?"
      body="Direct bookings get the lowest guaranteed rate — no OTA fees, no markup. Superior and Deluxe rooms available now."
      ctaLabel="Check Availability"
      ctaHref="/availability"
    />

  </main>

  <Footer />

</BaseLayout>

<script>
  function filterRoomsUI() {
    const select = document.getElementById('roomFilterSelect') as HTMLSelectElement;
    const filter = select?.value || 'all';
    document.querySelectorAll('.room-item').forEach((card) => {
      const el = card as HTMLElement;
      const match = filter === 'all' || el.dataset.room === filter;
      el.style.display = match ? '' : 'none';
    });
  }

  // Expose globally for inline onsubmit
  (window as any).filterRoomsUI = filterRoomsUI;

  // Jump to anchor if URL has hash
  if (window.location.hash) {
    const id = window.location.hash.replace('#', '');
    const el = document.getElementById(`room-card-${id}`);
    if (el) setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'start' }), 300);
  }
</script>
