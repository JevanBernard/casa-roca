---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RoomCard from '../components/RoomCard.astro';
import AmenitiesGrid from '../components/AmenitiesGrid.astro';
import RoomComparisonTable from '../components/RoomComparisonTable.astro';
import StayPolicies from '../components/StayPolicies.astro';
import CTABanner from '../components/CTABanner.astro';
import { rooms as roomData } from '../data/rooms';

// `reversed` (which side the image sits on) is a page-layout detail, not a
// room fact, so it's derived here rather than stored in the shared data.
const rooms = roomData.map((room, i) => ({
  ...room,
  price: `IDR ${room.priceValue.toLocaleString('en-US')}`,
  reversed: i === 1,
}));

const schemaRooms = rooms.map((r) => ({
  '@context': 'https://schema.org',
  '@type': 'HotelRoom',
  name: r.name + ' — Casa Roca Canggu',
  description: r.description,
  occupancy: { '@type': 'QuantitativeValue', maxValue: r.capacity },
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Private balcony',  value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Rain shower',       value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Air conditioning',  value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Flat screen TV',    value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Free WiFi',         value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Free parking',      value: true },
  ],
}));
---

<BaseLayout
  title="Rooms at Casa Roca Canggu — Superior Double, Superior Twin & Deluxe Triple"
  description="Browse Superior Double, Superior Twin, and Deluxe Triple rooms at Casa Roca Canggu. All rooms include private balcony, en-suite rain shower, AC, TV & free parking. Book direct for best rates."
  canonical="https://casarocacanggu.com/rooms"
>
  {schemaRooms.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} slot="head" />
  ))}

  <Header />

  <main class="w-full pt-20 bg-[#fcf9f4]">

    <!-- Page header -->
    <section class="max-w-[1360px] mx-auto px-5 lg:px-12 pt-10 pb-6">
      <div class="flex flex-col gap-3 max-w-4xl">
        <div class="flex items-center gap-1 text-[#6E5249]">
          <span class="material-symbols-outlined text-[16px]">holiday_village</span>
          <span class="text-[11px] font-[600] leading-[16px] tracking-[0.2em] uppercase">
            Casa Roca Canggu — Accommodations
          </span>
        </div>
        <h1 class="font-['Playfair_Display'] text-[40px] font-[400] leading-[48px] tracking-[-0.01em] text-[#1E1B18]">
          Private Sanctuaries Crafted for Rest & Renewal
        </h1>
        <p class="text-[16px] font-[400] leading-[26px] text-[#504441] max-w-2xl">
          Only 10 thoughtfully appointed private rooms on Jl. Batu Bolong. Each featuring a private
          balcony, en-suite rain shower, whisper-quiet AC, and dedicated basement parking —
          200 meters to the beach.
        </p>
      </div>

      <!-- Perks bar -->
      <div class="mt-8 p-4 bg-[#F3EFE8] rounded-xl shadow-sm flex flex-wrap items-center justify-between gap-3">
        {[
          { icon: 'lock',         label: 'Private Rooms — No Shared Guest Spaces' },
          { icon: 'balcony',      label: 'Private Balcony in Every Room' },
          { icon: 'shower',       label: 'En-Suite Rain Shower' },
          { icon: 'local_parking',label: 'Free Secured Basement Parking' },
          { icon: 'surfing',      label: '200m Stroll to Batu Bolong Surf' },
        ].map(({ icon, label }) => (
          <div class="flex items-center gap-1 text-[#1E1B18]">
            <span class="material-symbols-outlined text-[#6E5249] text-[20px]">{icon}</span>
            <span class="text-[13px] font-[500]">{label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Quick filter bar -->
    <section class="max-w-[1360px] mx-auto px-5 lg:px-12 pb-16">
      <div class="p-6 bg-white rounded-xl shadow-md">
        <form id="rooms-filter-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4 items-end">

          <div class="lg:col-span-3 flex flex-col gap-1">
            <label for="rooms-checkin" class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63]">Check-in</label>
            <div class="flex items-center bg-[#F3EFE8] rounded px-4 py-2.5">
              <span class="material-symbols-outlined text-[#6E5249] text-[18px] mr-2">calendar_today</span>
              <input type="date" id="rooms-checkin" name="checkin" class="bg-transparent w-full text-[#1E1B18] text-[13px] font-[500] focus:outline-none" />
            </div>
          </div>

          <div class="lg:col-span-3 flex flex-col gap-1">
            <label for="rooms-checkout" class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63]">Check-out</label>
            <div class="flex items-center bg-[#F3EFE8] rounded px-4 py-2.5">
              <span class="material-symbols-outlined text-[#6E5249] text-[18px] mr-2">calendar_today</span>
              <input type="date" id="rooms-checkout" name="checkout" class="bg-transparent w-full text-[#1E1B18] text-[13px] font-[500] focus:outline-none" />
            </div>
          </div>

          <div class="lg:col-span-2 flex flex-col gap-1">
            <label for="roomFilterSelect" class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63]">Room Type</label>
            <div class="flex items-center bg-[#F3EFE8] rounded px-4 py-2.5">
              <select id="roomFilterSelect" name="room" class="bg-transparent w-full text-[#1E1B18] text-[13px] font-[500] focus:outline-none cursor-pointer">
                <option value="all">All Room Types (3)</option>
                <option value="double">Superior Double</option>
                <option value="twin">Superior Twin</option>
                <option value="triple">Deluxe Triple</option>
              </select>
            </div>
          </div>

          <div class="lg:col-span-2 flex flex-col gap-1">
            <label for="rooms-guests" class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63]">Guests</label>
            <div class="flex items-center bg-[#F3EFE8] rounded px-4 py-2.5">
              <span class="material-symbols-outlined text-[#6E5249] text-[18px] mr-2">group</span>
              <select id="rooms-guests" name="guests" class="bg-transparent w-full text-[#1E1B18] text-[13px] font-[500] focus:outline-none cursor-pointer">
                <option value="1">1 Guest</option>
                <option value="2" selected>2 Guests</option>
                <option value="3">3 Guests</option>
              </select>
            </div>
          </div>

          <div class="lg:col-span-2 flex flex-col justify-end">
            <button type="submit" class="w-full flex items-center justify-center gap-1 py-3 px-4 bg-[#6E5249] hover:bg-[#553b33] text-white rounded text-[13px] font-[500] shadow-sm transition-all">
              <span class="material-symbols-outlined text-[18px]">search</span>
              <span>Check Rates</span>
            </button>
          </div>

        </form>
      </div>
    </section>

    <!-- Room cards -->
    <section class="max-w-[1360px] mx-auto px-5 lg:px-12 pb-24">
      <div class="flex flex-col gap-16" id="rooms-list">
        {rooms.map((room) => <RoomCard {...room} bookHref={`/availability?room=${room.id}`} />)}
      </div>
    </section>

    <AmenitiesGrid />
    <RoomComparisonTable />
    <StayPolicies />
    <CTABanner
      title="Ready to book your room?"
      body="Direct bookings get the lowest guaranteed rate — no OTA fees, no markup. Superior and Deluxe rooms available now."
      ctaLabel="Check Availability"
      ctaHref="/availability"
    />

  </main>

  <Footer />

</BaseLayout>

<script>
  function filterRoomsUI() {
    const select = document.getElementById('roomFilterSelect') as HTMLSelectElement;
    const filter = select?.value || 'all';
    document.querySelectorAll('.room-item').forEach((card) => {
      const el = card as HTMLElement;
      const match = filter === 'all' || el.dataset.room === filter;
      el.style.display = match ? '' : 'none';
    });
  }

  // Live-filter the on-page list as a nice-to-have while browsing...
  document.getElementById('roomFilterSelect')?.addEventListener('change', filterRoomsUI);

  // ...but "Check Rates" means check real rates for these dates, so submitting
  // the form takes the visitor to /availability with what they entered rather
  // than just re-filtering this static list and discarding their dates.
  const filterForm = document.getElementById('rooms-filter-form');
  filterForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(filterForm as HTMLFormElement);
    const params = new URLSearchParams();
    for (const key of ['checkin', 'checkout', 'guests']) {
      const value = data.get(key);
      if (value) params.set(key, String(value));
    }
    const room = data.get('room');
    if (room && room !== 'all') params.set('room', String(room));
    const query = params.toString();
    window.location.href = query ? `/availability?${query}` : '/availability';
  });

  // Jump to anchor if URL has hash
  if (window.location.hash) {
    const id = window.location.hash.replace('#', '');
    const el = document.getElementById(`room-card-${id}`);
    if (el) setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'start' }), 300);
  }
</script>
