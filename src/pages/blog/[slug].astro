---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props:  { post },
  }));
}

const { post }        = Astro.props;
const { Content }     = await post.render();

const allPosts = await getCollection('blog');
const related  = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: {
    '@type': 'Organization',
    name: post.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Casa Roca Canggu',
    url: 'https://casarocacanggu.com',
  },
  image: post.data.image,
  mainEntityOfPage: `https://casarocacanggu.com/blog/${post.slug}`,
};
---

<BaseLayout
  title={`${post.data.title} — Casa Roca Canggu`}
  description={post.data.description}
  canonical={`https://casarocacanggu.com/blog/${post.slug}`}
  image={post.data.image}
  schema={articleSchema}
>
  <Header />

  <main class="w-full pt-20 bg-[#fcf9f4]">

    <!-- Article header -->
    <header class="max-w-[1360px] mx-auto px-5 lg:px-12 pt-10 pb-8">
      <div class="max-w-3xl">
        <div class="flex flex-wrap items-center gap-3 mb-5">
          <a href="/blog" class="text-[12px] font-[500] text-[#8A6D63] hover:text-[#6E5249] flex items-center gap-1 transition-colors">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            Journal
          </a>
          <span class="text-[#c6c7c0]">·</span>
          <span class="text-[11px] font-[600] uppercase tracking-widest text-[#6E5249] bg-[#F3EFE8] px-2 py-0.5 rounded">
            {post.data.category}
          </span>
          <span class="text-[#c6c7c0]">·</span>
          <span class="text-[12px] font-[500] text-[#8A6D63]">{post.data.readTime}</span>
        </div>

        <h1 class="font-['Playfair_Display'] text-[32px] lg:text-[48px] font-[400] leading-[40px] lg:leading-[56px] tracking-[-0.01em] text-[#1E1B18] mb-5">
          {post.data.title}
        </h1>
        <p class="text-[16px] font-[400] leading-[26px] text-[#504441] mb-6">
          {post.data.description}
        </p>

        <div class="flex items-center gap-3 pb-6 border-b border-[#EAE5DC]">
          <div class="w-9 h-9 rounded-full bg-[#F3EFE8] flex items-center justify-center text-[#6E5249]">
            <span class="material-symbols-outlined text-[18px]">person</span>
          </div>
          <div>
            <span class="text-[13px] font-[600] text-[#1E1B18] block">{post.data.author}</span>
            <span class="text-[12px] font-[500] text-[#8A6D63]">{formatDate(post.data.pubDate)}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Hero image -->
    {post.data.image && (
      <div class="max-w-[1360px] mx-auto px-5 lg:px-12 mb-10">
        <div class="w-full aspect-[21/9] rounded-xl overflow-hidden shadow-md">
          <img
            src={post.data.image}
            alt={post.data.imageAlt || post.data.title}
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      </div>
    )}

    <!-- Article body -->
    <div class="max-w-[1360px] mx-auto px-5 lg:px-12 pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

        <!-- Content -->
        <article class="lg:col-span-8 prose-content">
          <Content />
        </article>

        <!-- Sidebar -->
        <aside class="lg:col-span-4 space-y-6">

          <!-- Book CTA -->
          <div class="bg-[#6E5249] text-white p-6 rounded-xl sticky top-32">
            <span class="text-[11px] font-[600] uppercase tracking-widest text-[#e3beb3] block mb-2">Stay in Canggu</span>
            <h3 class="font-['Playfair_Display'] text-[22px] font-[500] leading-[30px] text-white mb-3">
              Casa Roca Canggu
            </h3>
            <p class="text-[14px] font-[400] leading-[22px] text-[#e3beb3] mb-5">
              10 private rooms on Jl. Batu Bolong. 200m to Batu Bolong Beach. Free basement parking.
            </p>
            <a
              href="/availability"
              class="block w-full text-center bg-white text-[#1E1B18] px-5 py-3 rounded-md text-[13px] font-[600] hover:bg-[#F3EFE8] transition-colors mb-3"
            >
              Check Availability
            </a>
            <a
              href="/rooms"
              class="block w-full text-center border border-white/30 text-white px-5 py-3 rounded-md text-[13px] font-[500] hover:bg-white/10 transition-colors"
            >
              View Rooms & Rates
            </a>
          </div>

          <!-- Location card -->
          <div class="bg-[#F3EFE8] p-5 rounded-xl">
            <h4 class="text-[13px] font-[600] text-[#1E1B18] mb-3 flex items-center gap-1">
              <span class="material-symbols-outlined text-[#6E5249] text-[18px]">pin_drop</span>
              Our Location
            </h4>
            <p class="text-[13px] font-[400] leading-[20px] text-[#504441]">
              Jl. Pantai Batu Bolong, Canggu, Badung, Bali 80361
            </p>
            <a
              href="https://maps.app.goo.gl/XDhPWpNPfqz8EDCD8"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 mt-2 text-[12px] font-[500] text-[#6E5249] hover:underline"
            >
              Open in Google Maps ↗
            </a>
          </div>

        </aside>
      </div>
    </div>

    <!-- Related posts -->
    {related.length > 0 && (
      <section class="w-full bg-[#F3EFE8] py-12">
        <div class="max-w-[1360px] mx-auto px-5 lg:px-12">
          <h2 class="font-['Playfair_Display'] text-[28px] font-[500] leading-[36px] text-[#1E1B18] mb-8">
            More from the Journal
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {related.map((p) => (
              <a href={`/blog/${p.slug}`} class="group block bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                {p.data.image && (
                  <div class="aspect-[16/10] overflow-hidden">
                    <img
                      src={p.data.image}
                      alt={p.data.imageAlt || p.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-5">
                  <span class="text-[11px] font-[600] uppercase tracking-widest text-[#6E5249] block mb-1">{p.data.category}</span>
                  <h3 class="font-['Playfair_Display'] text-[18px] font-[500] leading-[26px] text-[#1E1B18] group-hover:text-[#6E5249] transition-colors">
                    {p.data.title}
                  </h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

  </main>

  <Footer />

</BaseLayout>

<style>
  .prose-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    line-height: 1.3;
    font-weight: 500;
    color: #1E1B18;
    margin-top: 52px;
    margin-bottom: 16px;
  }
  .prose-content h3 {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 500;
    color: #1E1B18;
    margin-top: 36px;
    margin-bottom: 12px;
  }
  .prose-content p {
    font-size: 16px;
    line-height: 1.8;
    color: #504441;
    margin-bottom: 22px;
  }
  .prose-content ul, .prose-content ol {
    margin-left: 24px;
    margin-bottom: 24px;
  }
  .prose-content li {
    font-size: 16px;
    line-height: 1.8;
    color: #504441;
    margin-bottom: 8px;
  }
  .prose-content strong {
    font-weight: 600;
    color: #1E1B18;
  }
  .prose-content a {
    color: #6E5249;
    text-decoration: underline;
  }
  .prose-content hr {
    border: none;
    border-top: 1px solid #EAE5DC;
    margin: 40px 0;
  }
  .prose-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
    font-size: 14px;
  }
  .prose-content th {
    text-align: left;
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #8A6D63;
    border-bottom: 2px solid #6E5249;
  }
  .prose-content td {
    padding: 12px 14px;
    color: #1E1B18;
    border-bottom: 1px solid #EAE5DC;
  }
  .prose-content blockquote {
    border-left: 3px solid #6E5249;
    padding-left: 20px;
    margin: 24px 0;
    font-style: italic;
    color: #504441;
  }
  .prose-content h2 + p, .prose-content h3 + p { margin-top: 0; }
</style>
