---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABanner from '../components/CTABanner.astro';

// ─── Gallery data ──────────────────────────────────────────────────────────────
// Ganti src dengan path gambar asli: /images/gallery/nama-file.jpg
const mosaic = [
  { src: '/images/gallery/hero-facade.jpg',   alt: 'Casa Roca Canggu facade',       title: 'Fasad Arsitektur',    desc: 'Handcrafted sandstone arches welcoming the Bali golden hour' },
  { src: '/images/gallery/double-bed.jpg',    alt: 'Superior Double bedroom',        title: 'Superior Double',     desc: 'Queen bed with crisp organic linen and terracotta accents' },
  { src: '/images/gallery/twin-bed.jpg',      alt: 'Superior Twin bedroom',          title: 'Superior Twin',       desc: 'Two single beds with traditional Balinese woven textiles' },
  { src: '/images/gallery/deluxe-room.jpg',   alt: 'Deluxe Triple Room',             title: 'Deluxe Triple',       desc: 'Spacious suite with king bed and single daybed' },
  { src: '/images/gallery/balcony.jpg',       alt: 'Private balcony garden view',    title: 'Balkon Pribadi',      desc: 'Secluded tropical terrace overlooking palm canopies' },
];

const categories = [
  {
    id: 'category-double',
    title: 'Superior Double Room',
    photos: [
      { src: '/images/gallery/double-bed.jpg',      alt: 'Kamar Tidur Utama Superior Double', label: 'Kamar Tidur Utama',  title: 'Kamar Tidur Utama — Superior Double', desc: 'Queen bed with crisp linen and terracotta accents' },
      { src: '/images/gallery/double-bathroom.jpg', alt: 'En-suite bathroom Superior Double',  label: 'Kamar Mandi En-Suite', title: 'Kamar Mandi En-Suite', desc: 'Handmade zellige terracotta tiles and open skylight rain shower' },
      { src: '/images/gallery/double-balcony.jpg',  alt: 'Private balcony Superior Double',    label: 'Balkon Pribadi',    title: 'Balkon Pribadi',      desc: 'Private sunlit terrace with rattan daybed' },
    ],
  },
  {
    id: 'category-twin',
    title: 'Superior Twin Room',
    photos: [
      { src: '/images/gallery/twin-bed.jpg',      alt: '2 Single Beds Superior Twin',  label: '2 Single Beds',        title: '2 Single Beds — Twin Sanctuary', desc: 'Twin bedroom with clean organic linen and ambient lighting' },
      { src: '/images/gallery/twin-bathroom.jpg', alt: 'En-suite bathroom Twin Room',  label: 'Kamar Mandi En-Suite', title: 'Kamar Mandi En-Suite',           desc: 'Rain shower with warm stone finish' },
      { src: '/images/gallery/twin-balcony.jpg',  alt: 'Private balcony Twin Room',    label: 'Balkon Pribadi',       title: 'Balkon Pribadi',                 desc: 'Shaded balcony with tropical garden view' },
    ],
  },
  {
    id: 'category-triple',
    title: 'Deluxe Triple Room',
    photos: [
      { src: '/images/gallery/deluxe-room.jpg',      alt: 'Deluxe Triple king + single', label: 'King + Single Bed',     title: 'Deluxe Triple — Expanded Suite', desc: 'King bed and single daybed in an expanded 32 sqm layout' },
      { src: '/images/gallery/deluxe-bathroom.jpg',  alt: 'Deluxe en-suite bathroom',    label: 'Kamar Mandi Deluxe',    title: 'Kamar Mandi Deluxe',             desc: 'Larger en-suite bathroom with premium rain shower' },
      { src: '/images/gallery/deluxe-balcony.jpg',   alt: 'Expanded balcony Deluxe',     label: 'Balkon Terrace',        title: 'Balkon Terrace Expanded',        desc: 'Wider private terrace with garden lounge area' },
    ],
  },
  {
    id: 'category-outdoors',
    title: 'Outdoor & Suasana',
    photos: [
      { src: '/images/gallery/hero-facade.jpg',    alt: 'Casa Roca facade exterior',    label: 'Fasad Eksterior',       title: 'Fasad Arsitektur Casa Roca',   desc: 'Sun-bleached limestone arches and terracotta warmth' },
      { src: '/images/gallery/courtyard.jpg',      alt: 'Casa Roca inner courtyard',    label: 'Courtyard',             title: 'Inner Courtyard',              desc: 'Tropical garden sanctuary at the heart of the property' },
      { src: '/images/gallery/street-view.jpg',    alt: 'Jl. Batu Bolong street view',  label: 'Suasana Jl. Batu Bolong', title: 'Suasana Jl. Batu Bolong',    desc: 'The iconic beachside street just outside our gate' },
    ],
  },
];

// Flatten all photos for lightbox navigation
const allPhotos = categories.flatMap((c) => c.photos.map((p) => ({ ...p, category: c.id })));
---

<BaseLayout
  title="Gallery — Casa Roca Canggu | Superior Double, Twin & Deluxe Triple Rooms"
  description="Browse photos of Casa Roca Canggu — Superior Double, Superior Twin, and Deluxe Triple rooms with private balconies, en-suite bathrooms, and tropical outdoor spaces on Jl. Batu Bolong."
  canonical="https://casarocacanggu.com/gallery"
>
  <Header />

  <main class="w-full pt-20 bg-[#fcf9f4]">

    <!-- Header -->
    <section class="w-full pt-6 pb-3">
      <div class="max-w-[1360px] mx-auto px-5 lg:px-12">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div class="flex flex-col gap-1">
            <h1 class="font-['Playfair_Display'] text-[28px] lg:text-[40px] font-[400] leading-[36px] lg:leading-[48px] tracking-[-0.01em] text-[#1E1B18]">
              Gallery - Casa Roca Canggu
            </h1>
            <div class="flex items-center gap-2 text-[#8A6D63] text-[14px] font-[400]">
              <span>10 Private Rooms</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Hero Mosaic -->
    <section class="w-full py-4">
      <div class="max-w-[1360px] mx-auto px-5 lg:px-12">
        <div class="relative rounded-2xl overflow-hidden shadow-sm border border-[#EAE5DC] bg-[#F3EFE8]">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-1.5 h-[300px] sm:h-[420px] lg:h-[500px]">

            <!-- Main large photo — col 1-2 -->
            <div
              class="md:col-span-2 relative h-full overflow-hidden cursor-zoom-in group"
              onclick={`openLightbox(0)`}
            >
              <img
                src={mosaic[0].src}
                alt={mosaic[0].alt}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="eager"
              />
              <div class="absolute inset-0 bg-[#1E1B18]/10 group-hover:bg-transparent transition-colors"></div>
            </div>

            <!-- 2×2 grid right -->
            <div class="hidden md:grid md:col-span-2 grid-cols-2 gap-1.5 h-full">
              {mosaic.slice(1).map((photo, idx) => (
                <div
                  class="relative h-full overflow-hidden cursor-zoom-in group"
                  onclick={`openLightbox(${idx + 1})`}
                >
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-[#1E1B18]/10 group-hover:bg-transparent transition-colors"></div>
                </div>
              ))}
            </div>

          </div>

          <!-- Show all photos button -->
          <button
            onclick="openLightbox(0)"
            class="absolute bottom-4 right-4 bg-white/95 backdrop-blur-md text-[#1E1B18] hover:bg-[#F3EFE8] px-4 py-2 rounded-md text-[13px] font-[600] shadow-md flex items-center gap-1 transition-colors"
          >
            <span class="material-symbols-outlined text-[18px]">photo_library</span>
            See All Photos ({allPhotos.length})
          </button>
        </div>
      </div>
    </section>

    <!-- Sticky Category Nav -->
    <div class="sticky top-20 z-30 w-full bg-[#FAF7F2]/95 backdrop-blur-md py-2.5 border-b border-[#EAE5DC] shadow-[0_2px_8px_rgba(30,27,24,0.02)]">
      <div class="max-w-[1360px] mx-auto px-5 lg:px-12">
        <div class="flex items-center gap-2 overflow-x-auto py-0.5 scrollbar-none" id="gallery-nav">
          <button
            class="cat-nav-btn px-4 py-2 rounded-full text-[13px] font-[500] transition-all bg-[#6E5249] text-white shadow-sm whitespace-nowrap"
            data-target="all"
          >
            All Photos
          </button>
          {categories.map((cat) => (
            <button
              class="cat-nav-btn px-4 py-2 rounded-full text-[13px] font-[500] transition-all bg-[#F3EFE8] text-[#504441] hover:bg-[#f0ede9] hover:text-[#1E1B18] whitespace-nowrap"
              data-target={cat.id}
            >
              {cat.title}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Photo Sections per Category -->
    <div class="w-full pb-24">
      {categories.map((cat) => (
        <section class="gallery-category-section w-full pt-10 pb-8" id={cat.id}>
          <div class="max-w-[1360px] mx-auto px-5 lg:px-12">

            <!-- Section header -->
            <div class="flex items-center justify-between pb-4 border-b border-[#EAE5DC]/70 mb-5">
              <div class="flex items-center gap-2">
                <h2 class="font-['Playfair_Display'] text-[22px] font-[500] leading-[30px] text-[#1E1B18]">{cat.title}</h2>
                <span class="text-[#8A6D63] text-[12px] font-[500]">· {cat.photos.length} foto</span>
              </div>
              <a
                href="/rooms"
                class="text-[#6E5249] hover:text-[#553b33] hover:underline text-[13px] font-[500] inline-flex items-center gap-1 transition-colors"
              >
                <span>Detail Kamar</span>
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
              </a>
            </div>

            <!-- Photo grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {cat.photos.map((photo) => {
                const globalIdx = allPhotos.findIndex((p) => p.src === photo.src && p.category === cat.id);
                return (
                  <div
                    class="group relative rounded-xl overflow-hidden bg-[#F3EFE8] border border-[#EAE5DC] cursor-zoom-in shadow-sm hover:shadow-md transition-all"
                    onclick={`openLightbox(${globalIdx})`}
                  >
                    <div class="aspect-[4/3] w-full overflow-hidden">
                      <img
                        src={photo.src}
                        alt={photo.alt}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                      />
                    </div>
                    <div class="p-3 bg-white flex items-center justify-between">
                      <span class="text-[13px] font-[600] text-[#1E1B18]">{photo.label}</span>
                      <span class="material-symbols-outlined text-[18px] text-[#8A6D63] group-hover:text-[#6E5249] transition-colors">zoom_in</span>
                    </div>
                  </div>
                );
              })}
            </div>

          </div>
        </section>
      ))}
    </div>

    <CTABanner
      title="Suka dengan apa yang kamu lihat?"
      body="10 private rooms on Jl. Batu Bolong, Canggu — 200m from Batu Bolong Beach. Book direct for the lowest guaranteed rate."
      ctaLabel="Check Availability"
      ctaHref="/availability"
    />

  </main>

  <Footer />

  <!-- Lightbox Modal -->
  <div
    class="fixed inset-0 z-50 bg-[#1E1B18]/95 backdrop-blur-md hidden items-center justify-center p-4"
    id="gallery-lightbox"
  >
    <div class="relative max-w-5xl w-full max-h-[92vh] flex flex-col bg-white rounded-2xl overflow-hidden shadow-2xl border border-[#EAE5DC]">

      <!-- Top bar -->
      <div class="flex items-center justify-between px-5 py-3 bg-white border-b border-[#EAE5DC]">
        <div class="flex items-center gap-3">
          <span class="text-[18px] font-[600] text-[#1E1B18]" id="lightbox-title">Casa Roca Canggu</span>
          <span class="text-[13px] font-[500] text-[#8A6D63]" id="lightbox-counter">1 / 12</span>
        </div>
        <button
          aria-label="Close"
          class="w-8 h-8 rounded-full bg-[#F3EFE8] flex items-center justify-center text-[#1E1B18] hover:bg-[#f0ede9] transition-colors"
          onclick="closeLightbox()"
        >
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>

      <!-- Image -->
      <div class="relative w-full flex-1 max-h-[70vh] bg-[#1E1B18]/5 flex items-center justify-center overflow-hidden">
        <img
          alt="Casa Roca Canggu"
          class="max-w-full max-h-[66vh] object-contain"
          id="lightbox-img"
          src=""
        />

        <!-- Prev / Next -->
        <button
          onclick="navigateLightbox(-1)"
          class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/90 flex items-center justify-center shadow-md hover:bg-white transition-colors"
          aria-label="Previous"
        >
          <span class="material-symbols-outlined text-[20px]">chevron_left</span>
        </button>
        <button
          onclick="navigateLightbox(1)"
          class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/90 flex items-center justify-center shadow-md hover:bg-white transition-colors"
          aria-label="Next"
        >
          <span class="material-symbols-outlined text-[20px]">chevron_right</span>
        </button>
      </div>

      <!-- Caption bar -->
      <div class="px-5 py-3 bg-white border-t border-[#EAE5DC] flex items-center justify-between gap-4">
        <p class="text-[14px] font-[400] text-[#504441] line-clamp-1" id="lightbox-desc">
          Batu Bolong, Canggu, Bali
        </p>
        <a
          href="/availability"
          class="shrink-0 inline-flex items-center gap-1 bg-[#6E5249] hover:bg-[#553b33] text-white px-4 py-1.5 rounded-md text-[13px] font-[500] transition-colors"
        >
          Book Direct
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
      </div>
    </div>
  </div>

</BaseLayout>

<script define:vars={{ allPhotos }}>
  // ─── Category filter / scroll ──────────────────────────────────────────────
  document.querySelectorAll('.cat-nav-btn').forEach((btn) => {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.cat-nav-btn').forEach((b) => {
        b.classList.remove('bg-[#6E5249]', 'text-white', 'shadow-sm');
        b.classList.add('bg-[#F3EFE8]', 'text-[#504441]');
      });
      this.classList.add('bg-[#6E5249]', 'text-white', 'shadow-sm');
      this.classList.remove('bg-[#F3EFE8]', 'text-[#504441]');

      const target = this.dataset.target;
      const sections = document.querySelectorAll('.gallery-category-section');

      if (target === 'all') {
        sections.forEach((s) => s.classList.remove('hidden'));
        const first = document.getElementById('category-double');
        if (first) window.scrollTo({ top: first.offsetTop - 150, behavior: 'smooth' });
      } else {
        sections.forEach((s) => {
          if (s.id === target) {
            s.classList.remove('hidden');
            s.scrollIntoView({ behavior: 'smooth', block: 'start' });
          } else {
            s.classList.add('hidden');
          }
        });
      }
    });
  });

  // ─── Lightbox ─────────────────────────────────────────────────────────────
  const modal    = document.getElementById('gallery-lightbox');
  const lbImg    = document.getElementById('lightbox-img');
  const lbTitle  = document.getElementById('lightbox-title');
  const lbDesc   = document.getElementById('lightbox-desc');
  const lbCtr    = document.getElementById('lightbox-counter');
  let currentIdx = 0;

  function renderLightbox(idx) {
    currentIdx = (idx + allPhotos.length) % allPhotos.length;
    const photo = allPhotos[currentIdx];
    lbImg.src          = photo.src;
    lbImg.alt          = photo.alt;
    lbTitle.textContent = photo.title || 'Casa Roca Canggu';
    lbDesc.textContent  = photo.desc  || 'Batu Bolong, Canggu, Bali';
    lbCtr.textContent   = `${currentIdx + 1} / ${allPhotos.length}`;
  }

  window.openLightbox = function (idx) {
    renderLightbox(idx);
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  window.closeLightbox = function () {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  window.navigateLightbox = function (dir) {
    renderLightbox(currentIdx + dir);
  };

  modal?.addEventListener('click', (e) => { if (e.target === modal) window.closeLightbox(); });

  document.addEventListener('keydown', (e) => {
    if (!modal || modal.classList.contains('hidden')) return;
    if (e.key === 'Escape')      window.closeLightbox();
    if (e.key === 'ArrowLeft')   window.navigateLightbox(-1);
    if (e.key === 'ArrowRight')  window.navigateLightbox(1);
  });
</script>
