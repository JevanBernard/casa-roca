---
---

<section class="w-full max-w-[1360px] mx-auto px-6 lg:px-12 py-16 lg:pb-24">
  <div class="relative w-full rounded-2xl bg-[#6E5249] text-white overflow-hidden p-8 lg:p-24 shadow-[0_24px_48px_-12px_rgba(110,82,73,0.3)]">

    <!-- Atmospheric blurs -->
    <div class="absolute -right-16 -bottom-16 w-96 h-96 rounded-full bg-[#553b33]/40 blur-3xl pointer-events-none"></div>
    <div class="absolute -left-12 -top-12 w-64 h-64 rounded-full bg-[#8A6D63]/30 blur-2xl pointer-events-none"></div>

    <div class="relative z-10 max-w-2xl mx-auto text-center flex flex-col items-center">
      <span class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#e3beb3] mb-3">
        Direct Reserve Privilege
      </span>
      <h2 class="font-['Playfair_Display'] text-[38px] lg:text-[56px] font-[400] leading-[46px] lg:leading-[64px] text-[#fcf9f4] mb-4 font-light leading-tight">
        Ready to stay in Canggu?
      </h2>
      <p class="text-[16px] font-[400] leading-[26px] text-[#FAF7F2] mb-10 max-w-lg font-light">
        Experience one of Canggu's best-located private rooms with 2 minutes walk to Batu Bolong
        Beach. Book direct for the lowest rate.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center justify-center gap-4 w-full">
        <a
          href="/availability"
          class="inline-flex items-center justify-center bg-[#fcf9f4] hover:bg-[#F3EFE8] text-[#1E1B18] px-10 py-4 rounded-md text-[13px] font-[600] transition-all duration-300 shadow-md hover:-translate-y-0.5"
        >
          Check Availability
        </a>
        <a
          href="https://wa.me/62XXXXXXXXX"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1 bg-[#5A6351]/40 hover:bg-[#5A6351]/60 text-[#fcf9f4] backdrop-blur-md px-6 py-4 rounded-md text-[13px] font-[500] transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]">chat</span>
          <span>WhatsApp Host</span>
        </a>
      </div>

      <!-- Micro guarantees -->
      <div class="mt-10 pt-6 flex flex-wrap items-center justify-center gap-6 text-[12px] font-[500] text-[#e3beb3]">
        <span class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">price_check</span>
          Best Rate Guaranteed
        </span>
        <span class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">lock_reset</span>
          Flexible Modification
        </span>
        <span class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">support_agent</span>
          Dedicated Host Support
        </span>
      </div>
    </div>
  </div>
</section>
