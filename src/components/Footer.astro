---
const sanctuaryLinks = [
  { label: 'Suites & Studios', href: '/rooms' },
  { label: 'Visual Gallery',   href: '/gallery' },
  { label: 'Neighbourhood',    href: '/location' },
  { label: 'Our Philosophy',   href: '/about' },
  { label: 'Canggu Journal',   href: '/blog' },
];
---

<footer class="w-full bg-[#F3EFE8] shadow-[0_-1px_12px_rgba(30,27,24,0.03)]">
  <div class="max-w-[1360px] mx-auto px-6 lg:px-12 pt-24 pb-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-16 pb-16">

      <!-- Brand -->
      <div class="md:col-span-5 lg:col-span-4 flex flex-col gap-4">
        <div class="flex items-center gap-2">
          <img
            src="/images/logo.png"
            alt="Casa Roca Canggu Logo"
            class="h-8 w-auto object-contain"
            onerror="this.style.display='none'"
          />
          <span class="font-['Playfair_Display'] text-[22px] font-[500] leading-[30px] text-[#1E1B18]">
            Casa Roca Canggu
          </span>
        </div>
        <p class="text-[14px] font-[400] leading-[22px] text-[#504441] max-w-sm">
          An intimate sanctuary of sun-bleached stone, terracotta warmth, and tropical tranquility.
          Thoughtfully designed boutique suites in the serene heart of Canggu, Bali.
        </p>
        <div class="pt-1">
          <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-[#EFF2EC] text-[#5A6351] text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-[#5A6351] animate-pulse"></span>
            Direct Booking Privilege
          </span>
        </div>
      </div>

      <!-- Sanctuary links -->
      <div class="md:col-span-3 lg:col-span-2 flex flex-col gap-4">
        <h3 class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#1E1B18]">Sanctuary</h3>
        <ul class="flex flex-col gap-3">
          {sanctuaryLinks.map(({ label, href }) => (
            <li>
              <a href={href} class="text-[14px] font-[400] text-[#504441] hover:text-[#1c1c19] transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Location & Hours -->
      <div class="md:col-span-4 lg:col-span-3 flex flex-col gap-4">
        <h3 class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#1E1B18]">Location & Hours</h3>
        <div class="flex flex-col gap-1 text-[14px] font-[400] leading-[22px] text-[#504441]">
          <p>Jl. Batu Bolong, Canggu</p>
          <p>Badung, Bali 80361, Indonesia</p>
          <p class="text-[12px] font-[500] text-[#8A6D63] pt-1">Reception: 08:00 – 20:00 WITA</p>
          <p class="text-[12px] font-[500] text-[#8A6D63]">Check-in: 14:00 · Check-out: 12:00</p>
          <div class="pt-1">
            <a
              href="https://maps.app.goo.gl/DK2PNL8ZCmrYri848"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-[12px] font-[500] text-[#6E5249] hover:text-[#553b33] transition-colors hover:underline"
            >
              <span class="material-symbols-outlined text-[16px]">pin_drop</span>
              <span>View on Google Maps ↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- WhatsApp concierge -->
      <div class="md:col-span-12 lg:col-span-3 flex flex-col gap-4 bg-[#fcf9f4] p-6 rounded-xl shadow-[0_8px_24px_-6px_rgba(110,82,73,0.06)]">
        <span class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#6E5249]">Boutique Concierge</span>
        <h4 class="font-['Playfair_Display'] text-[22px] font-[500] leading-[30px] text-[#1E1B18]">Reserve via WhatsApp</h4>
        <p class="text-[14px] font-[400] leading-[22px] text-[#504441]">
          Connect instantly with our hosts for room questions, special requests, and direct guest privileges.
        </p>
        <a
          href="https://wa.me/62XXXXXXXXX"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1 bg-[#5A6351] hover:bg-[#3b4433] text-white py-2 px-4 rounded-md text-[13px] font-[500] transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]">chat</span>
          Chat Direct with Host
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-6 border-t border-[#EAE5DC] flex flex-col sm:flex-row items-center justify-between gap-4 text-[#504441] text-[12px] font-[500]">
      <p>© {new Date().getFullYear()} Casa Roca Canggu. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-[#1c1c19] transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-[#1c1c19] transition-colors">Terms of Stay</a>
      </div>
    </div>
  </div>
</footer>
