---
import { rooms, getRoomById } from '../data/rooms';

const bathroomLabel = (type: 'rain-shower' | 'bathtub') =>
  type === 'rain-shower' ? 'Private En-Suite Rain Shower' : 'Private En-Suite Bathtub';

const double = getRoomById('double')!;
const twin = getRoomById('twin')!;
const triple = getRoomById('triple')!;

const rows = [
  { label: 'Room Size',         double: double.size,                        twin: twin.size,                        triple: `${triple.size} (Expanded)` },
  { label: 'Bed Configuration', double: double.bed,                         twin: twin.bed,                         triple: triple.bed },
  { label: 'Max Occupancy',     double: `${double.capacity} Adults`,        twin: `${twin.capacity} Adults`,        triple: `Up to ${triple.capacity} Adults` },
  { label: 'Balcony Type',      double: 'Standard Private',                 twin: 'Standard Private',               triple: 'Standard Private' },
  { label: 'Bathroom',          double: bathroomLabel(double.bathroomType), twin: bathroomLabel(twin.bathroomType), triple: bathroomLabel(triple.bathroomType) },
  { label: 'Smart TV',          double: '32" 4K Flat Screen',               twin: '32" 4K Flat Screen',             triple: '32" 4K Flat Screen' },
  { label: 'Ideal For',         double: 'Solo workers & couples',           twin: 'Surf buddies & travel friends',  triple: 'Small families & extended stays' },
];
---

<section class="w-full max-w-[1360px] mx-auto px-5 lg:px-12 pb-16 lg:pb-24">
  <div class="text-center max-w-2xl mx-auto mb-12 space-y-1">
    <span class="text-[11px] font-[600] leading-[16px] tracking-[0.2em] uppercase text-[#6E5249] block">At A Glance</span>
    <h2 class="font-['Playfair_Display'] text-[40px] font-[400] leading-[48px] tracking-[-0.01em] text-[#1E1B18]">
      Compare Room Categories
    </h2>
    <p class="text-[14px] font-[400] leading-[22px] text-[#504441]">
      Select the layout that best aligns with your coastal Bali retreat.
    </p>
  </div>

  <div class="bg-white rounded-xl shadow-md overflow-x-auto">
    <table class="w-full text-left border-collapse min-w-[720px]">
      <thead>
        <tr class="bg-[#F3EFE8] text-[#1E1B18] text-[18px] font-[600] leading-[26px]">
          <th class="p-4 lg:p-6 w-1/4 font-semibold">Feature / Room</th>
          <th class="p-4 lg:p-6 w-1/4 font-semibold">
            <span class="block">Superior Double</span>
            <span class="text-[12px] font-[500] text-[#8A6D63]">22 m² Sanctuary</span>
          </th>
          <th class="p-4 lg:p-6 w-1/4 font-semibold">
            <span class="block">Superior Twin</span>
            <span class="text-[12px] font-[500] text-[#8A6D63]">22 m² Twin Layout</span>
          </th>
          <th class="p-4 lg:p-6 w-1/4 font-semibold bg-[#EFF2EC]/40">
            <span class="block">Deluxe Triple</span>
            <span class="text-[12px] font-[500] text-[#5A6351]">32 m² Deluxe</span>
          </th>
        </tr>
      </thead>
      <tbody class="text-[14px] font-[400] leading-[22px] text-[#1E1B18]">
        {rows.map(({ label, double: d, twin, triple }, i) => (
          <tr class:list={['transition-colors hover:bg-[#f6f3ee]', i % 2 === 0 ? 'bg-white' : 'bg-[#f6f3ee]/40']}>
            <td class="p-4 lg:p-6 font-medium text-[#8A6D63]">{label}</td>
            <td class="p-4 lg:p-6">{d}</td>
            <td class="p-4 lg:p-6">{twin}</td>
            <td class="p-4 lg:p-6 bg-[#EFF2EC]/20 font-semibold text-[#1E1B18]">{triple}</td>
          </tr>
        ))}

        <!-- Price row -->
        <tr class="bg-[#F3EFE8]">
          <td class="p-4 lg:p-6 font-semibold text-[#1E1B18]">Direct Rate</td>
          <td class="p-4 lg:p-6 font-semibold text-[#6E5249]">from IDR {double.priceValue.toLocaleString('en-US')}</td>
          <td class="p-4 lg:p-6 font-semibold text-[#6E5249]">from IDR {twin.priceValue.toLocaleString('en-US')}</td>
          <td class="p-4 lg:p-6 bg-[#EFF2EC] font-semibold text-[#5A6351]">from IDR {triple.priceValue.toLocaleString('en-US')}</td>
        </tr>

        <!-- CTA row -->
        <tr class="bg-white">
          <td class="p-4 lg:p-6"></td>
          {rooms.map((room) => (
            <td class:list={['p-4 lg:p-6', room.id === 'triple' && 'bg-[#EFF2EC]/30']}>
              <a
                href={`/availability?room=${room.id}`}
                class:list={[
                  'inline-flex items-center justify-center w-full py-2 px-3 text-white text-[13px] font-[500] rounded shadow-sm transition-all',
                  room.id === 'triple' ? 'bg-[#3b4433] hover:bg-[#1E1B18]' : 'bg-[#6E5249] hover:bg-[#553b33]',
                ]}
              >
                Book {room.name.replace(/^(Superior|Deluxe)\s/, '').replace(/\sRoom$/, '')}
              </a>
            </td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>
</section>
