---
import { getRoomById } from '../data/rooms';

// Price comes from the shared room data source so it can't drift from
// /rooms or /availability again; the rest is this card's own curated
// homepage copy (subtitle, short amenity chips) rather than raw fact data.
const rooms = [
  {
    id: 'superior-twin',
    badge: 'Superior Twin',
    title: 'Superior Twin Room',
    subtitle: '2 Single Beds · Sleeps 2',
    description:
      'Perfect for two travelers or solo guests who want extra space. Two single beds with solid teak furniture, large windows, and a private balcony overlooking the garden.',
    priceFrom: `IDR ${getRoomById('twin')!.priceValue.toLocaleString('en-US')}`,
    image: '/images/superior-twin-room.jpg',
    imageAlt: 'Superior Twin Room at Casa Roca Canggu - two single beds and private balcony',
    href: '/rooms#twin',
    amenities: ['2 Single Beds', 'Private balcony', 'En-suite rain shower', 'AC + flat screen TV'],
  },
  {
    id: 'superior-double',
    badge: 'Superior Double',
    title: 'Superior Double Room',
    subtitle: '1 Double Bed · Sleeps 2',
    description:
      'Ideal for couples. One double bed with solid teak furniture, large windows, and a private balcony. Same premium finishes as the Twin in a more intimate layout.',
    priceFrom: `IDR ${getRoomById('double')!.priceValue.toLocaleString('en-US')}`,
    image: '/images/superior-double-room.jpg',
    imageAlt: 'Superior Double Room at Casa Roca Canggu - double bed and private balcony',
    href: '/rooms#double',
    amenities: ['1 Double Bed', 'Private balcony', 'En-suite rain shower', 'AC + flat screen TV'],
  },
  {
    id: 'deluxe',
    badge: 'Deluxe Triple',
    title: 'Deluxe Triple Room',
    subtitle: 'Double + Twin Beds · Sleeps up to 3',
    description:
      'More floor space, same premium finishes. The Deluxe is the right choice for longer stays, families, or anyone who wants room to actually breathe. Sleeps up to 3 guests.',
    priceFrom: `IDR ${getRoomById('triple')!.priceValue.toLocaleString('en-US')}`,
    image: '/images/deluxe-room.jpg',
    imageAlt: 'Deluxe Triple Room at Casa Roca Canggu - spacious room with en-suite bathroom',
    href: '/rooms#triple',
    amenities: ['Double + Twin Beds', 'Private balcony', 'En-suite rain shower', 'Sleeps 3'],
  },
];
---

<section class="w-full max-w-[1360px] mx-auto px-6 lg:px-12 py-16 lg:py-24" id="rooms-showcase">

  <!-- Section header -->
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-12">
    <div>
      <span class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63] block mb-2">
        Guest Suites
      </span>
      <h2 class="font-['Playfair_Display'] text-[40px] font-[400] leading-[48px] tracking-[-0.01em] text-[#1E1B18]">
        Superior and Deluxe rooms
      </h2>
    </div>
    <a
      href="/rooms"
      class="inline-flex items-center gap-1 text-[13px] font-[500] text-[#6E5249] hover:text-[#553b33] transition-colors group shrink-0"
    >
      <span>View all rooms</span>
      <span class="material-symbols-outlined text-[18px] transition-transform duration-200 group-hover:translate-x-1">arrow_forward</span>
    </a>
  </div>

  <!-- Room cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {rooms.map((room) => (
      <a href={room.href} class="group block border border-[#EAE5DC] rounded-xl overflow-hidden hover:shadow-[0_12px_32px_-8px_rgba(110,82,73,0.08),0_4px_12px_-2px_rgba(30,27,24,0.04)] transition-all duration-300">

        <!-- Image -->
        <div class="relative aspect-[16/10] overflow-hidden">
          <img
            src={room.image}
            alt={room.imageAlt}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <!-- Price pill -->
          <div class="absolute top-4 right-4 bg-[#1E1B18]/65 backdrop-blur-sm text-white px-3 py-1 rounded-full text-[12px] font-[500]">
            from {room.priceFrom} / night
          </div>
          <!-- Badge -->
          <div class="absolute top-4 left-4 bg-[#6E5249] text-white px-3 py-1 rounded-full text-[11px] font-[600] tracking-[0.08em] uppercase">
            {room.badge}
          </div>
        </div>

        <!-- Content -->
        <div class="p-6">
          <div class="flex items-start justify-between mb-3">
            <div>
              <h3 class="font-['Playfair_Display'] text-[22px] font-[500] leading-[30px] text-[#1E1B18]">
                {room.title}
              </h3>
              <p class="text-[12px] font-[500] text-[#8A6D63] mt-0.5">{room.subtitle}</p>
            </div>
            <span class="material-symbols-outlined text-[#6E5249] group-hover:translate-x-1 transition-transform mt-1">arrow_forward</span>
          </div>

          <p class="text-[14px] font-[400] leading-[22px] text-[#504441] mb-5">
            {room.description}
          </p>

          <!-- Amenity chips -->
          <div class="flex flex-wrap gap-2">
            {room.amenities.map((amenity) => (
              <span class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-[#F3EFE8] text-[#504441] text-[12px] font-[500]">
                {amenity}
              </span>
            ))}
          </div>
        </div>

      </a>
    ))}
  </div>

</section>