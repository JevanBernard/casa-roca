---
---

<section class="w-full max-w-[1360px] mx-auto px-6 lg:px-12 py-16 lg:py-24">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-24 items-center">

    <!-- Narrative column -->
    <div class="lg:col-span-6 flex flex-col justify-center">
      <div class="inline-flex items-center gap-1 text-[#6E5249] text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase mb-3">
        <span>Batu Bolong · Canggu</span>
      </div>
      <h2 class="font-['Playfair_Display'] text-[40px] font-[400] leading-[48px] tracking-[-0.01em] text-[#1E1B18] mb-6 leading-tight">
        What is Casa Roca Canggu?
      </h2>
      <p class="text-[16px] font-[400] leading-[26px] text-[#504441] mb-4 leading-relaxed">
        Casa Roca is a 10-room boutique guest house located on Jl. Batu Bolong, Canggu, Bali
        directly next to Aston Canggu Hotel. Every room includes a private balcony, en-suite rain
        shower bathroom, air conditioning, flat screen TV, and free basement parking.
      </p>

      <!-- Positioning callout -->
      <div class="bg-[#f6f3ee] rounded-xl p-6 my-4 shadow-sm">
        <p class="font-['Playfair_Display'] text-[22px] font-[500] leading-[30px] text-[#1E1B18] italic mb-2">
          "Built for travelers who are done with hostels and don't need a full villa — just a
          private, well-finished room in a location they can actually walk to the beach from."
        </p>
        <div class="flex items-center gap-1 text-[12px] font-[500] text-[#8A6D63] pt-2">
          <span class="material-symbols-outlined text-[#6E5249] text-[16px]">schedule</span>
          <span>Reception is open daily 08.00–20.00 WITA.</span>
        </div>
      </div>

      <!-- Stats bento -->
      <div class="grid grid-cols-3 gap-4 my-6">
        <div class="bg-[#F3EFE8] p-4 rounded-md">
          <span class="block font-['Playfair_Display'] text-[28px] font-[500] leading-[36px] text-[#1E1B18]">10</span>
          <span class="text-[12px] font-[500] leading-[16px] tracking-[0.02em] text-[#504441] uppercase tracking-wider">Private Rooms</span>
        </div>
        <div class="bg-[#F3EFE8] p-4 rounded-md">
          <span class="block font-['Playfair_Display'] text-[28px] font-[500] leading-[36px] text-[#6E5249]">2 min</span>
          <span class="text-[12px] font-[500] leading-[16px] tracking-[0.02em] text-[#504441] uppercase tracking-wider">Walk to Beach</span>
        </div>
        <div class="bg-[#F3EFE8] p-4 rounded-md">
          <span class="block font-['Playfair_Display'] text-[28px] font-[500] leading-[36px] text-[#5A6351]">100%</span>
          <span class="text-[12px] font-[500] leading-[16px] tracking-[0.02em] text-[#504441] uppercase tracking-wider">Private Spaces</span>
        </div>
      </div>

      <a
        href="/about"
        class="inline-flex items-center gap-1 text-[13px] font-[500] text-[#6E5249] hover:text-[#553b33] transition-colors group"
      >
        <span>Learn more about the property</span>
        <span class="material-symbols-outlined text-[18px] transition-transform duration-200 group-hover:translate-x-1">arrow_forward</span>
      </a>
    </div>

    <!-- Image column -->
    <div class="lg:col-span-6 relative">
      <div class="relative w-full aspect-[4/5] rounded-xl overflow-hidden shadow-[0_16px_40px_-10px_rgba(30,27,24,0.1)]">
        <img
          src="/images/about-room.jpg"
          alt="Intricately carved Balinese wooden screen catching warm golden light at Casa Roca Canggu"
          class="w-full h-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#1E1B18]/30 via-transparent to-transparent"></div>
      </div>

      <!-- Floating badge -->
      <div class="absolute -bottom-6 -left-6 bg-white p-4 rounded-xl shadow-[0_12px_28px_-6px_rgba(30,27,24,0.12)] hidden sm:flex items-center gap-4 max-w-xs">
        <div class="w-10 h-10 rounded-full bg-[#EFF2EC] flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[#5A6351]">hotel</span>
        </div>
        <div>
          <p class="text-[13px] font-[600] text-[#1E1B18] leading-snug">Neighboring Aston Canggu</p>
          <p class="text-[12px] font-[500] text-[#504441]">Prime Batu Bolong strip</p>
        </div>
      </div>
    </div>

  </div>
</section>
