---
---

<section class="relative w-full overflow-hidden bg-[#FAF7F2] -mt-20 pt-20">
  <div class="relative w-full min-h-[620px] lg:min-h-[720px] flex items-end">

    <!-- Hero image -->
    <div
      class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 scale-[1.01]"
      style="background-image: url('/images/hero.jpg');"
      role="img"
      aria-label="Sunlit boutique suite at Casa Roca Canggu Bali"
    ></div>

    <!-- Gradient scrims -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#1E1B18]/90 via-[#1E1B18]/50 to-[#1E1B18]/25"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#1E1B18]/75 via-transparent to-transparent"></div>

    <!-- Content -->
    <div class="relative z-10 w-full max-w-[1360px] mx-auto px-6 lg:px-12 pb-28 pt-32 lg:pt-40">

      <!-- Overline -->
      <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-white/20 backdrop-blur-md text-white mb-4">
        <span class="w-2 h-2 rounded-full bg-[#c0cab4] animate-pulse"></span>
        <span class="text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#fcf9f4]">
          Pantai Batu Bolong · Canggu · Bali
        </span>
      </div>

      <!-- Headline -->
      <div class="max-w-3xl">
        <h1 class="font-['Playfair_Display'] text-[38px] lg:text-[56px] font-[400] leading-[46px] lg:leading-[64px] tracking-[-0.01em] lg:tracking-[-0.02em] text-[#fcf9f4] mb-4 font-light">
          Private Rooms in the Heart of{' '}
          <span class="italic font-normal text-[#e3beb3]">Batu Bolong</span>, Canggu
        </h1>
        <p class="text-[16px] font-[400] leading-[26px] text-[#e5e2dd]/90 max-w-xl mb-10 font-light">
          10 private rooms each with a balcony, en-suite bathroom &amp; free parking.
          2 minutes walk to Batu Bolong Beach.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/availability"
            class="inline-flex items-center justify-center bg-[#fcf9f4] hover:bg-[#F3EFE8] text-[#1E1B18] px-10 py-4 rounded-md text-[13px] font-[600] transition-all duration-300 shadow-[0_12px_32px_-8px_rgba(0,0,0,0.35)] hover:-translate-y-0.5"
          >
            Book a Room — Best Rate Direct
          </a>
          <a
            href="/rooms"
            class="inline-flex items-center justify-center bg-white/20 hover:bg-white/35 text-[#fcf9f4] backdrop-blur-md px-6 py-4 rounded-md text-[13px] font-[500] transition-all duration-300"
          >
            See All Rooms
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating Booking Bar -->
  <div class="relative z-20 max-w-[1360px] mx-auto px-6 lg:px-12 -mt-14 mb-16" id="availability">
    <div class="bg-white rounded-xl shadow-[0_20px_48px_-12px_rgba(30,27,24,0.12)] p-4 lg:p-6">
      <form id="hero-booking-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4 items-center">

        <!-- Check-in -->
        <div class="lg:col-span-3 bg-[#f6f3ee] p-2 rounded-md hover:bg-[#f0ede9] transition-colors">
          <label for="hero-checkin" class="block text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63] mb-0.5">Check In</label>
          <div class="flex items-center gap-1 text-[#1E1B18]">
            <span class="material-symbols-outlined text-[#6E5249] text-[20px]">calendar_today</span>
            <input
              type="date"
              id="hero-checkin"
              name="checkin"
              class="bg-transparent text-[13px] font-[600] text-[#1E1B18] focus:outline-none w-full cursor-pointer"
            />
          </div>
        </div>

        <!-- Check-out -->
        <div class="lg:col-span-3 bg-[#f6f3ee] p-2 rounded-md hover:bg-[#f0ede9] transition-colors">
          <label for="hero-checkout" class="block text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63] mb-0.5">Check Out</label>
          <div class="flex items-center gap-1 text-[#1E1B18]">
            <span class="material-symbols-outlined text-[#6E5249] text-[20px]">event</span>
            <input
              type="date"
              id="hero-checkout"
              name="checkout"
              class="bg-transparent text-[13px] font-[600] text-[#1E1B18] focus:outline-none w-full cursor-pointer"
            />
          </div>
        </div>

        <!-- Room Type -->
        <div class="lg:col-span-2 bg-[#f6f3ee] p-2 rounded-md hover:bg-[#f0ede9] transition-colors">
          <label for="hero-room" class="block text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63] mb-0.5">Room Type</label>
          <div class="flex items-center gap-1 text-[#1E1B18]">
            <span class="material-symbols-outlined text-[#6E5249] text-[20px]">bed</span>
            <select id="hero-room" name="room" class="bg-transparent text-[13px] font-[600] text-[#1E1B18] focus:outline-none w-full cursor-pointer">
              <option value="">All Room Types</option>
              <option value="double">Superior Double</option>
              <option value="twin">Superior Twin</option>
              <option value="triple">Deluxe Triple</option>
            </select>
          </div>
        </div>

        <!-- Guests -->
        <div class="lg:col-span-2 bg-[#f6f3ee] p-2 rounded-md hover:bg-[#f0ede9] transition-colors">
          <label for="hero-guests" class="block text-[11px] font-[600] leading-[16px] tracking-[0.12em] uppercase text-[#8A6D63] mb-0.5">Guests</label>
          <div class="flex items-center gap-1 text-[#1E1B18]">
            <span class="material-symbols-outlined text-[#6E5249] text-[20px]">group</span>
            <select id="hero-guests" name="guests" class="bg-transparent text-[13px] font-[600] text-[#1E1B18] focus:outline-none w-full cursor-pointer">
              <option value="1">1 Guest</option>
              <option value="2" selected>2 Guests</option>
              <option value="3">3 Guests</option>
            </select>
          </div>
        </div>

        <!-- CTA -->
        <div class="lg:col-span-2 flex items-center">
          <button
            type="submit"
            class="w-full min-h-[52px] bg-[#6E5249] hover:bg-[#553b33] text-white rounded-md text-[13px] font-[500] flex items-center justify-center gap-1 shadow-[0_4px_16px_-4px_rgba(110,82,73,0.3)] transition-all hover:-translate-y-0.5"
          >
            <span>Check Rates</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </button>
        </div>
      </form>

      <!-- Trust signals -->
      <div class="mt-3 pt-1 bg-[#f6f3ee]/50 -mx-4 -mb-4 lg:-mx-6 lg:-mb-6 px-4 lg:px-6 py-1.5 rounded-b-xl flex flex-wrap items-center justify-between gap-2 text-[12px] font-[500] text-[#504441]">
        <div class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[#5A6351] text-[16px]">verified</span>
          <span>Direct Booking Guarantee · Lowest Rate Protected</span>
        </div>
        <div class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[#5A6351] text-[16px]">local_parking</span>
          <span>Complimentary Secure Basement Parking</span>
        </div>
        <div class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[#5A6351] text-[16px]">surfing</span>
          <span>200m Flat Walk to Batu Bolong Surf Break</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Carry the visitor's search into /availability instead of discarding it —
  // the previous version always redirected with no query params.
  const heroForm = document.getElementById('hero-booking-form');
  heroForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(heroForm as HTMLFormElement);
    const params = new URLSearchParams();
    for (const key of ['checkin', 'checkout', 'room', 'guests']) {
      const value = data.get(key);
      if (value) params.set(key, String(value));
    }
    const query = params.toString();
    window.location.href = query ? `/availability?${query}` : '/availability';
  });
</script>
